<!-- =====================================================================
     FOUR STEPS
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-12 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-secondary mb-3">Developer Workflow</span>
      <h2>From Zero to Production in 4 Steps</h2>
      <p>Install once, then scaffold, develop, and deploy — no toolchain fatigue, no breaking dependency trees.</p>
    </div>

    <!-- Grid: 1 col → sm: 2 col → md: 4 col -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 lg:gap-5">

      <!-- Step 1: Install -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">1</span>
          <span class="badge badge-primary text-2xs font-mono">Install</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw install</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3">One command installs the <code class="code-inline">kiw</code> CLI on Linux or macOS. No package manager needed.</p>
        <pre class="term-block mt-auto text-xs"><code>curl -fsSL \
  https://krewire.com/scripts/install.sh \
  | sh</code></pre>
      </div>

      <!-- Step 2: Scaffold -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">2</span>
          <span class="badge badge-secondary text-2xs font-mono">Scaffold</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw new</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3">Generate a production-ready project template for any workload in under one second.</p>
        <pre class="term-block mt-auto text-xs"><code>kiw new my-site --site
cd my-site</code></pre>
      </div>

      <!-- Step 3: Develop -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">3</span>
          <span class="badge badge-secondary text-2xs font-mono">Develop</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw dev</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3">Instant hot-reload local development server with file-based routing and scoped CSS updates.</p>
        <pre class="term-block mt-auto text-xs"><code>kiw dev
# ⚡ Ready at http://localhost:8080</code></pre>
      </div>

      <!-- Step 4: Deploy -->
      <div class="card">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="icon-box bg-primary text-primary-content text-base font-black">4</span>
          <span class="badge badge-secondary text-2xs font-mono">Deploy</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw deploy</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-3">Compile into a single static binary or static asset bundle and ship to GitHub Pages or Docker.</p>
        <pre class="term-block mt-auto text-xs"><code>kiw deploy --target gh-pages
# ✓ Deployed successfully!</code></pre>
      </div>

    </div>
  </div>
</section>


<!-- =====================================================================
     WHY KREWIRE
     ===================================================================== -->
<section class="w-full bg-bg dark:bg-bg-dark py-12 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-primary mb-3">Architecture &amp; Philosophy</span>
      <h2>Go-First. Progressive. Zero Bloat.</h2>
      <p>Built for engineers who value compilation speed, predictable deployments, and maintainable software architecture.</p>
    </div>

    <!-- Grid: 1 col → sm: 2 col → lg: 4 col -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">◈</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark">Pure Go Toolchain</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">No Node.js, no npm dependencies, and no bundler configuration. Your entire application compiles with standard Go tooling into clean, self-contained binaries.</p>
      </div>

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">◧</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark">Scoped .kiw Components</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">Combines YAML frontmatter, standard Go HTML templates, and scoped <code class="code-inline">&lt;style&gt;</code> blocks. CSS classes never leak outside their component boundary.</p>
      </div>

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">⚡</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark">Progressive Scaling</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">Start as a lightweight static site, grow into a fullstack web monolith, then seamlessly extract background workers and microservices — all within the same ecosystem.</p>
      </div>

      <div class="card">
        <span class="icon-box bg-secondary text-secondary-content mb-4 text-xl">🛡</span>
        <h3 class="text-base font-black tracking-tight mb-2 text-fg dark:text-fg-dark">Enterprise Resilience</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">Engineered with production defaults: structured JSON logging, distributed tracing, health checks, circuit breakers, and graceful shutdown out of the box.</p>
      </div>

    </div>
  </div>
</section>

<!-- =====================================================================
     DSL SHOWCASE
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-12 lg:py-16" style="border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-secondary mb-3">Component DSL</span>
      <h2>Write Pages as Clean .kiw Components</h2>
      <p>The elegance of Svelte and Astro brought to Go. Frontmatter + HTML + scoped CSS in one intuitive file.</p>
    </div>

    <!-- Grid: 1 col → md: 2 col -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-start">

      <!-- Code panel -->
      <div class="rounded-xl overflow-hidden" style="background:#0B1F3B; border:var(--pop-border); box-shadow:var(--pop-shadow-lg)">
        <!-- Panel header -->
        <div class="flex items-center gap-2.5 px-4 py-3" style="background:#071426; border-bottom:var(--pop-border-thin)">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-accent" style="border:1.5px solid #000"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]" style="border:1.5px solid #000"></span>
            <span class="w-3 h-3 rounded-full bg-primary" style="border:1.5px solid #000"></span>
          </div>
          <span class="ml-auto font-mono text-xs font-extrabold text-slate-400 tracking-widest uppercase">pages/index.kiw</span>
        </div>
        <!-- Code -->
        <pre class="m-0 px-5 py-5 overflow-x-auto font-mono text-sm leading-relaxed" style="color:#FAF8F4"><code><span style="color:#64748b;font-style:italic">---</span>
<span style="color:#00D1C1;font-weight:700">title:</span> "Welcome to Krewire"
<span style="color:#00D1C1;font-weight:700">layout:</span> Landing
<span style="color:#64748b;font-style:italic">---</span>

<span style="color:#39D353;font-weight:700">&lt;section class="welcome"&gt;</span>
