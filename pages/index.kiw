<section class="w-full bg-bg dark:bg-bg-dark py-12 lg:py-16">
  <div class="container-site">
    <div class="rounded-2xl text-center bg-bg-2 dark:bg-bg-dark-2 bg-dots px-5 py-12 md:px-10 lg:px-16 lg:py-16"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow-lg)">
      <span class="badge badge-primary mb-4">Ready to Build</span>
      <h2 class="font-black tracking-tight mb-3 text-fg dark:text-fg-dark"
          style="font-size:clamp(22px,5vw,36px); letter-spacing:-0.03em">
        Start Building with Krewire Today
      </h2>
      <p class="text-base text-muted dark:text-muted-dark leading-relaxed mx-auto mb-7" style="max-width:640px">
        Start with a lightweight static site, scale to a web monolith, then to distributed cloud services — one repository, one CLI, one configuration.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-6">
        <a href="/getting-started" class="btn btn-primary btn-lg">Get Started — 5 Min →</a>
        <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="btn btn-lg"><span>★</span> Star on GitHub</a>
      </div>
      <div class="inline-flex items-center gap-2.5 rounded-[10px] px-3.5 py-2.5 bg-bg dark:bg-bg-dark max-w-md mx-auto overflow-x-auto"
           style="border:var(--pop-border); box-shadow:var(--pop-shadow-sm)">
        <span class="font-mono font-black text-primary text-sm shrink-0">$</span>
        <code class="font-mono text-xs font-bold text-fg dark:text-fg-dark whitespace-nowrap">kiw new my-app --site &amp;&amp; cd my-app &amp;&amp; kiw dev</code>
        <button class="btn-copy shrink-0 text-xs font-black px-2.5 py-1 rounded-md bg-secondary text-secondary-content transition-all duration-150"
                style="border:var(--pop-border-thin); box-shadow:1.5px 1.5px 0px var(--border)"
                onclick="copyCmd(this,'kiw new my-app --site && cd my-app && kiw dev')">Copy</button>
      </div>
    </div>
  </div>
</section>



<style>
/* Btn-copy hover handled in JS; dark code panels need explicit bg */
.dark .showcase-code-panel { background: #071426; }
</style>
