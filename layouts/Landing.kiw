<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.Title}}</title>
  <meta name="description" content="Unified Go Framework for every workload — app, cli, site, book, worker, service, infra, runtime. One CLI kiw, one config krewire.yaml.">
  <link rel="canonical" href="https://krewire.com/">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <!-- OpenGraph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{.Title}}">
  <meta property="og:description" content="Unified Go Framework for every workload — app, cli, site, book, worker, service, infra, runtime. One CLI kiw, one config krewire.yaml.">
  <meta property="og:url" content="https://krewire.com/">
  <meta property="og:site_name" content="Krewire">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{.Title}}">
  <meta name="twitter:description" content="Unified Go Framework for every workload — app, cli, site, book, worker, service, infra, runtime. One CLI kiw, one config krewire.yaml.">

  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <link rel="stylesheet" href="/assets/forge.css">
  <script src="/assets/app.js"></script>
</head>
<body>

  <!-- NAVBAR -->
  <Navbar ShowSidebarToggle=false Version=.Version />

  <!-- PAGE CONTENT -->
  <main id="main">{{.Content}}</main>

  <!-- FOOTER -->
  <Footer Variant="full" Version=.Version />
</body>
</html>

<style>
/* Only what Tailwind can't express: CSS var-driven pop-shadow on dark
   and the theme-css-var tokens for style.css compatibility */
:root {
  --primary: #39D353;
  --primary-content: #0B1F3B;
  --secondary: #00D1C1;
  --secondary-content: #0B1F3B;
  --accent: #FF3B2E;
  --accent-content: #ffffff;
  --bg: #FAF8F4;
  --bg-2: #f2ede4;
  --fg: #0B1F3B;
  --muted: #57677d;
  --border: #0B1F3B;
  --border-subtle: rgba(11,31,59,.18);
  --radius: 10px;
  --success: #39D353;
  --warning: #ffb703;
  --error: #FF3B2E;
  --info: #00D1C1;
}
:root[data-theme="dark"], html[data-theme="dark"], .dark {
  --primary: #39D353 !important;
  --primary-content: #0B1F3B !important;
  --secondary: #00D1C1 !important;
  --secondary-content: #0B1F3B !important;
  --bg: #0B1F3B;
  --bg-2: #112646;
  --fg: #FAF8F4;
  --muted: #9ab0ce;
  --border: #FAF8F4;
  --border-subtle: rgba(250,248,244,.2);
}
</style>
