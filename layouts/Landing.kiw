<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.Title}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/theme.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <script>
    (function(){
      try{
        var t = localStorage.getItem("krewire-theme") || "auto";
        var m = t==="auto"? (matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light") : t;
        document.documentElement.dataset.theme = m;
      }catch(e){}
      window.krewireTheme={toggle:function(){
        var cur=document.documentElement.dataset.theme;
        var nxt=cur==="dark"?"light":"dark";
        document.documentElement.dataset.theme=nxt;
        try{localStorage.setItem("krewire-theme",nxt)}catch(e){}
      }};
    })();
  </script>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/">
        <span class="brand-mark">◈</span>
        <span class="brand-text">Krewire</span>
        {{with .Version}}<span class="badge">{{.}}</span>{{end}}
      </a>
      <nav class="links">
        <a href="/docs">Docs</a>
        <a href="/docs/getting-started">Get Started</a>
        <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener">GitHub</a>
      </nav>
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" onclick="window.krewireTheme.toggle()">
        <span class="sun">☀</span><span class="moon">☾</span>
      </button>
    </div>
  </header>
  <main class="landing-main">{{.Content}}</main>
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div>
          <div class="footer-brand"><span class="brand-mark">◈</span> Krewire</div>
          <p class="footer-desc">One Go Framework for Every Workload.<br>One CLI <code>kiw</code>, one config <code>krewire.yaml</code>.</p>
        </div>
        <div class="footer-col">
          <strong>Workloads</strong>
          <a href="/docs/workloads">app · cli · site · book</a>
          <a href="/docs/workloads">worker · service · infra · runtime</a>
        </div>
        <div class="footer-col">
          <strong>Resources</strong>
          <a href="/docs/getting-started">Getting Started</a>
          <a href="/docs">Documentation</a>
          <a href="https://github.com/krewire/framework/tree/main/docs/specs">Specs</a>
        </div>
        <div class="footer-col">
          <strong>Community</strong>
          <a href="https://github.com/krewire/krewire">GitHub</a>
          <a href="https://github.com/orgs/krewire/discussions">Forum</a>
          <a href="https://github.com/krewire/framework">Framework</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Krewire Contributors — Built 100% with Krewire <code>site</code> workload.</span>
        <span><a href="https://github.com/krewire">github.com/krewire</a></span>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
:root{
  --primary:#00c853;
  --primary-content:#ffffff;
  --bg:#ffffff;
  --bg-2:#f6f8f7;
  --fg:#0a0a0a;
  --muted:#6b7280;
  --border:rgba(10,10,10,.08);
  --radius:16px;
  --shadow:0 10px 30px rgba(10,10,10,.06);
  --show-sun:inline;
  --show-moon:none;
}
html[data-theme="dark"]{
  --bg:#0a0a0a;
  --bg-2:#111413;
  --fg:#f6f8f7;
  --muted:#9ca3af;
  --border:rgba(246,248,247,.12);
  --shadow:0 10px 30px rgba(0,0,0,.4);
  --show-sun:none;
  --show-moon:inline;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;background:var(--bg);color:var(--fg);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover{color:var(--primary)}
.nav{position:sticky;top:0;z-index:40;background:color-mix(in srgb, var(--bg) 85%, transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
.nav-inner{max-width:80rem;margin:0 auto;padding:14px 16px;display:flex;align-items:center;gap:14px}
.brand{font-weight:700;letter-spacing:-.02em;display:flex;align-items:center;gap:8px;font-size:15px}
.brand-mark{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;background:var(--primary);color:var(--primary-content);font-size:14px;line-height:1}
.brand-text{font-weight:800}
.brand .badge{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--primary);color:var(--primary-content);margin-left:2px}
.links{margin-left:auto;display:flex;gap:20px;font-size:14px;color:var(--muted);align-items:center}
.links a{color:var(--muted);font-weight:500}
.links a:hover{color:var(--fg)}
.theme-toggle{border:1px solid var(--border);background:var(--bg-2);border-radius:999px;padding:6px 10px;cursor:pointer}
.theme-toggle .sun{display:var(--show-sun)}
.theme-toggle .moon{display:var(--show-moon)}
.landing-main{min-width:0}
.footer{border-top:1px solid var(--border);margin-top:0;background:var(--bg-2)}
.footer-inner{max-width:80rem;margin:0 auto;padding:40px 16px 24px}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding-bottom:32px;border-bottom:1px solid var(--border)}
.footer-brand{font-weight:800;display:flex;align-items:center;gap:8px;margin-bottom:10px}
.footer-brand .brand-mark{width:24px;height:24px;font-size:12px;border-radius:6px}
.footer-desc{font-size:13px;color:var(--muted);line-height:1.6;margin:0}
.footer-desc code{font-family:ui-monospace, monospace;font-size:12px;background:var(--bg);border:1px solid var(--border);padding:1px 5px;border-radius:6px}
.footer-col{display:flex;flex-direction:column;gap:8px}
.footer-col strong{font-size:13px;margin-bottom:4px}
.footer-col a{font-size:13px;color:var(--muted)}
.footer-col a:hover{color:var(--primary)}
.footer-bottom{padding-top:16px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;font-size:12px;color:var(--muted)}
.footer-bottom a{color:var(--muted);text-decoration:underline;text-underline-offset:3px}
@media(max-width:900px){
  .footer-grid{grid-template-columns:1fr 1fr;gap:24px}
  .links{gap:14px;font-size:13px}
  .links a:nth-child(2){display:none}
}
@media(max-width:560px){
  .footer-grid{grid-template-columns:1fr}
  .nav-inner{padding:12px 14px}
}
</style>
