<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.Title}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/theme.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <script>
    (function(){
      try{
        var t = localStorage.getItem("krewire-theme") || "auto";
        var m = t==="auto"? (matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light") : t;
        document.documentElement.dataset.theme = m;
      }catch(e){}
      window.krewireTheme={toggle:function(){
        var cur=document.documentElement.dataset.theme;
        var nxt=cur==="dark"?"light":"dark";
        document.documentElement.dataset.theme=nxt;
        try{localStorage.setItem("krewire-theme",nxt)}catch(e){}
      }};
    })();
  </script>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <button class="sidebar-toggle" id="site-sidebar-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="site-sidebar">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
      </button>
      <a class="brand" href="/">Krewire{{with .Version}} <span class="badge">{{.}}</span>{{end}}</a>
      <nav class="links">
        <a href="/docs">Docs</a>
        <a href="https://github.com/krewire/framework">GitHub</a>
        <a href="https://github.com/orgs/krewire/discussions">Forum</a>
      </nav>
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" onclick="window.krewireTheme.toggle()">
        <span class="sun">☀</span><span class="moon">☾</span>
      </button>
    </div>
  </header>
  <div class="site-layout" id="site-layout">
    <aside class="site-sidebar" id="site-sidebar" aria-label="Sidebar">
      <div class="sidebar-head">
        <span class="sidebar-title">Navigate</span>
        <button class="sidebar-close" id="site-sidebar-close" aria-label="Close navigation">×</button>
      </div>
      <nav class="toc" id="site-toc">
        <!-- Example collapsible groups — replace with range when wired to data -->
        <div class="toc-group open" data-group>
          <div class="toc-parent-row">
            <a href="/docs" class="toc-link">Docs</a>
            <button class="toc-toggle" aria-expanded="true" aria-label="Toggle submenu">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
            </button>
          </div>
          <div class="toc-subs">
            <a href="/docs/getting-started" class="toc-sub">Getting Started</a>
            <a href="/docs/site" class="toc-sub">Site</a>
            <a href="/docs/book" class="toc-sub">Book</a>
          </div>
        </div>
        <div class="toc-group" data-group>
          <div class="toc-parent-row">
            <a href="/docs/specs" class="toc-link">Specs</a>
            <button class="toc-toggle" aria-expanded="false" aria-label="Toggle submenu">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
            </button>
          </div>
          <div class="toc-subs">
            <a href="/docs/specs/architecture" class="toc-sub">Architecture</a>
            <a href="/docs/specs/dsl" class="toc-sub">DSL</a>
          </div>
        </div>
        <a href="/about" class="toc-link">About</a>
      </nav>
    </aside>
    <div class="sidebar-overlay" id="site-sidebar-overlay" aria-hidden="true"></div>
    <main class="site-main">{{.Content}}</main>
  </div>
  <footer class="footer">
    <div class="footer-inner mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-xs text-muted sm:px-6 lg:px-8">
      <span>© 2026 Krewire Contributors — Built 100% with Krewire `site` workload.</span>
      <span><a href="https://github.com/krewire">github.com/krewire</a> · <a href="/docs/getting-started">Get Started</a></span>
    </div>
  </footer>
  <script>
    (function(){
      var layout=document.getElementById('site-layout');
      var sidebar=document.getElementById('site-sidebar');
      var toggle=document.getElementById('site-sidebar-toggle');
      var close=document.getElementById('site-sidebar-close');
      var overlay=document.getElementById('site-sidebar-overlay');
      function setOpen(o){
        document.documentElement.classList.toggle('sidebar-open', o);
        if(toggle) toggle.setAttribute('aria-expanded', o?'true':'false');
        if(sidebar) sidebar.setAttribute('aria-hidden', o?'false':'true');
      }
      if(toggle) toggle.addEventListener('click', function(){ setOpen(!document.documentElement.classList.contains('sidebar-open')); });
      if(close) close.addEventListener('click', function(){ setOpen(false); });
      if(overlay) overlay.addEventListener('click', function(){ setOpen(false); });
      document.addEventListener('keydown', function(e){ if(e.key==='Escape') setOpen(false); });
      document.querySelectorAll('#site-sidebar [data-group] .toc-toggle').forEach(function(btn){
        btn.addEventListener('click', function(){
          var g=btn.closest('[data-group]');
          var open=g.classList.toggle('open');
          btn.setAttribute('aria-expanded', open?'true':'false');
          try{ localStorage.setItem('krewire-site-toc-'+g.querySelector('.toc-link').getAttribute('href'), open?'1':'0'); }catch(_){}
        });
      });
      try{
        document.querySelectorAll('#site-sidebar [data-group]').forEach(function(g){
          var href=g.querySelector('.toc-link').getAttribute('href');
          var v=localStorage.getItem('krewire-site-toc-'+href);
          if(v==='0') g.classList.remove('open');
          if(v==='1') g.classList.add('open');
        });
      }catch(_){}
    })();
  </script>
</body>
</html>

<style>
:root{
  --primary:#00c853;
  --primary-content:#ffffff;
  --bg:#ffffff;
  --bg-2:#f6f8f7;
  --fg:#0a0a0a;
  --muted:#6b7280;
  --border:rgba(10,10,10,.08);
  --radius:16px;
  --shadow:0 10px 30px rgba(10,10,10,.06);
  --show-sun: inline;
  --show-moon: none;
}
html[data-theme="dark"]{
  --bg:#0a0a0a;
  --bg-2:#111413;
  --fg:#f6f8f7;
  --muted:#9ca3af;
  --border:rgba(246,248,247,.12);
  --shadow:0 10px 30px rgba(0,0,0,.4);
  --show-sun: none;
  --show-moon: inline;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;background:var(--bg);color:var(--fg);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover{color:var(--primary)}
.nav{position:sticky;top:0;z-index:40;background:color-mix(in srgb, var(--bg) 85%, transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
.nav-inner{max-width:80rem;margin:0 auto;padding:14px 16px;display:flex;align-items:center;gap:14px}
.brand{font-weight:700;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}
.brand .badge{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--primary);color:var(--primary-content)}
.links{margin-left:auto;display:flex;gap:18px;font-size:14px;color:var(--muted)}
.links a{color:var(--muted)}
.links a:hover{color:var(--fg)}
.theme-toggle{border:1px solid var(--border);background:var(--bg-2);border-radius:999px;padding:6px 10px;cursor:pointer}
.theme-toggle .sun{display:var(--show-sun)}
.theme-toggle .moon{display:var(--show-moon)}
.sidebar-toggle{
  display:inline-flex;align-items:center;justify-content:center;
  width:36px;height:36px;border:1px solid var(--border);border-radius:8px;background:var(--bg-2);color:var(--fg);cursor:pointer
}
.sidebar-toggle:hover{border-color:var(--primary);color:var(--primary)}
.site-layout{
  max-width:80rem;margin:0 auto;width:100%;
  display:grid;grid-template-columns:1fr;gap:1.5rem;
  padding:1.25rem 1rem 2rem;
}
.site-sidebar{
  font-family:Inter, ui-sans-serif, system-ui, sans-serif;
  font-size:0.92rem;
  background:var(--bg);
}
.sidebar-head{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:0.75rem;
}
.sidebar-title{margin:0;font-size:0.78rem;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted)}
.sidebar-close{
  display:none;border:1px solid var(--border);background:var(--bg-2);border-radius:8px;width:30px;height:30px;font-size:18px;cursor:pointer;color:var(--muted)
}
.sidebar-overlay{display:none}
.toc{display:flex;flex-direction:column;gap:2px}
.toc-link,.toc-sub{
  display:block;padding:0.38rem 0.6rem;border-radius:6px;color:var(--fg);text-decoration:none
}
.toc-link:hover,.toc-sub:hover{background:var(--bg-2)}
.toc-link.active,.toc-sub.active{background:var(--bg-2);color:var(--primary);font-weight:700}
.toc-sub{padding-left:1.4rem;font-size:0.88rem;color:var(--muted)}
.toc-sub.active{color:var(--primary)}
.toc-group{border-radius:6px}
.toc-parent-row{display:flex;align-items:center;gap:4px}
.toc-parent-row .toc-link{flex:1}
.toc-toggle{
  flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;
  width:26px;height:26px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--muted);cursor:pointer;
  transition:transform 0.15s ease, background 0.15s ease
}
.toc-toggle:hover{background:var(--bg-2);color:var(--fg)}
.toc-toggle svg{transition:transform 0.18s ease}
.toc-group.open > .toc-parent-row .toc-toggle svg{transform:rotate(90deg)}
.toc-subs{display:none;flex-direction:column;gap:2px;margin:2px 0 4px;border-left:1px solid var(--border);margin-left:0.7rem;padding-left:0.45rem}
.toc-group.open > .toc-subs{display:flex}
.site-main{min-width:0}
.footer{border-top:1px solid var(--border);margin-top:32px;background:var(--bg-2)}
.footer-inner a{color:var(--muted);text-decoration:underline;text-underline-offset:3px}

/* small: <40rem drawer */
@media (max-width: 39.99rem){
  .site-sidebar{
    position:fixed;top:0;left:0;bottom:0;
    width:min(82vw,19rem);max-width:19rem;
    padding:1rem 1rem 2rem;overflow-y:auto;
    border-right:1px solid var(--border);box-shadow:0 10px 40px rgba(0,0,0,0.18);
    transform:translateX(-100%);transition:transform 0.22s cubic-bezier(0.2,0.8,0.2,1);z-index:50;
  }
  .sidebar-close{display:inline-flex;align-items:center;justify-content:center}
  .sidebar-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.32);backdrop-filter:blur(2px);
    z-index:40;opacity:0;pointer-events:none;transition:opacity 0.2s ease;
  }
  html.sidebar-open .site-sidebar{transform:translateX(0)}
  html.sidebar-open .sidebar-overlay{opacity:1;pointer-events:auto;display:block}
  html.sidebar-open{overflow:hidden}
}
/* medium: 40–63.99rem */
@media (min-width: 40rem) and (max-width: 63.99rem){
  .site-layout{grid-template-columns:14rem minmax(0,1fr);gap:2rem;padding:1.5rem 1.25rem 2.5rem}
  .site-sidebar{align-self:start;position:sticky;top:4.8rem;max-height:calc(100vh - 5.5rem);overflow-y:auto}
  .sidebar-toggle,.sidebar-close,.sidebar-overlay{display:none !important}
}
/* large: 64rem+ */
@media (min-width: 64rem){
  .site-layout{grid-template-columns:16.5rem minmax(0,1fr);gap:2.5rem;padding:2rem 1.5rem 3rem}
  .site-sidebar{align-self:start;position:sticky;top:5rem;max-height:calc(100vh - 6rem);overflow-y:auto}
  .sidebar-toggle,.sidebar-close,.sidebar-overlay{display:none !important}
}
@media (min-width: 80rem){
  .site-layout{grid-template-columns:17rem minmax(0,1fr);gap:2.75rem}
}
</style>
