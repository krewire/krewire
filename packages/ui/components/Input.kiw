<div class="field-group {class}">
  {#if label}
  <label class="field-label" {#if id}for="{id}"{/if}>
    {label}
    {#if required}<span class="field-required" aria-hidden="true">*</span>{/if}
  </label>
  {/if}
  <input
    type="{#if type}{type}{:else}text{/if}"
    name="{name}"
    {#if id}id="{id}"{/if}
    {#if placeholder}placeholder="{placeholder}"{/if}
    {#if value}value="{value}"{/if}
    {#if required}required{/if}
    {#if disabled}disabled{/if}
    class="field-input {#if error}has-error{/if}"
    {#if help}aria-describedby="{id}-help"{/if}
  >
  {#if help}
  <span class="field-help" {#if id}id="{id}-help"{/if}>{help}</span>
  {/if}
  {#if error}
  <span class="field-error">{error}</span>
  {/if}
</div>

<style>
.field-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  margin-bottom: 1rem;
  box-sizing: border-box;
}
.field-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--fg, #0B1F3B);
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.field-required {
  color: var(--error, #FF3B2E);
  font-weight: 900;
}
.field-input {
  width: 100%;
  padding: 0.6rem 0.85rem;
  font-size: 0.9rem;
  font-family: inherit;
  border-radius: calc(var(--radius, 10px) - 2px);
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  background: var(--bg-2, #f0ede5);
  color: var(--fg, #0B1F3B);
  box-shadow: inset 1px 1px 0px rgba(0,0,0,0.08);
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.field-input:focus {
  border-color: var(--primary, #39D353);
  box-shadow: 0 0 0 2px var(--primary, #39D353);
}
.field-input.has-error {
  border-color: var(--error, #FF3B2E);
}
.field-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.field-help {
  font-size: 0.78rem;
  color: var(--muted, #475569);
}
.field-error {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--error, #FF3B2E);
}
</style>
