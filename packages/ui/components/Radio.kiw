<label class="kiw-radio-label {{if .Disabled}}is-disabled{{end}} {{.Class}}" {{with .ID}}id="{{.}}-label"{{end}} data-kiw-component="Radio">
  <input
    type="radio"
    name="{{.Name}}"
    {{with .ID}}id="{{.}}"{{end}}
    {{with .Value}}value="{{.}}"{{end}}
    {{if .Checked}}checked{{end}}
    {{if .Required}}required{{end}}
    {{if .Disabled}}disabled{{end}}
    class="kiw-radio-input"
  >
  <span class="kiw-radio-circle" aria-hidden="true">
    <span class="kiw-radio-dot"></span>
  </span>
  <span class="kiw-radio-text">{{if .Body}}{{.Body}}{{else}}{{.Label}}{{end}}</span>
</label>

<style>
.kiw-radio-label {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--fg, #0B1F3B);
  cursor: pointer;
  user-select: none;
}
.kiw-radio-label.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.kiw-radio-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  margin: 0;
}
.kiw-radio-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  background: var(--bg, #FAF8F4);
  box-shadow: var(--pop-sm, 2px 2px 0px var(--border, #0B1F3B));
  transition: background-color 0.15s ease;
  flex-shrink: 0;
}
.kiw-radio-dot {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--primary-content, #0B1F3B);
  display: none;
}
.kiw-radio-input:checked + .kiw-radio-circle {
  background: var(--primary, #39D353);
}
.kiw-radio-input:checked + .kiw-radio-circle .kiw-radio-dot {
  display: block;
}
.kiw-radio-input:focus-visible + .kiw-radio-circle {
  outline: 2px solid var(--primary, #39D353);
  outline-offset: 2px;
}
</style>
