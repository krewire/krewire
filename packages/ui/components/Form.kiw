<form action="{#if action}{action}{:else}#{/if}"
      method="{#if method}{method}{:else}POST{/if}"
      {#if enctype}enctype="{enctype}"{/if}
      class="kiw-form {class}"
      {#if id}id="{id}"{/if}
      data-kiw-component="Form">
  {body}
</form>

<style>
.kiw-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  width: 100%;
  box-sizing: border-box;
}
</style>
