<div class="field-group {class}">
  {#if label}
  <label class="field-label" {#if id}for="{id}"{/if}>
    {label}
    {#if required}<span class="field-required" aria-hidden="true">*</span>{/if}
  </label>
  {/if}
  <div class="select-wrapper">
    <select
      name="{name}"
      {#if id}id="{id}"{/if}
      {#if required}required{/if}
      {#if disabled}disabled{/if}
      class="field-input field-select {#if error}has-error{/if}"
      {#if help}aria-describedby="{id}-help"{/if}
    >
      {body}
    </select>
    <div class="select-arrow" aria-hidden="true">▼</div>
  </div>
  {#if help}
  <span class="field-help" {#if id}id="{id}-help"{/if}>{help}</span>
  {/if}
  {#if error}
  <span class="field-error">{error}</span>
  {/if}
</div>

<style>
.select-wrapper {
  position: relative;
  width: 100%;
}
.field-select {
  appearance: none;
  -webkit-appearance: none;
  padding-right: 2.5rem;
  cursor: pointer;
}
.select-arrow {
  position: absolute;
  right: 0.85rem;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  font-size: 0.75rem;
  color: var(--muted, #57677d);
}
</style>
