<a href="{#if href}{href}{:else}/{/if}"
   class="brand flex items-center gap-2 font-black tracking-tight text-fg dark:text-fg-dark shrink-0 no-underline hover:no-underline hover:text-fg dark:hover:text-fg-dark {class}">
  <span class="brand-icon icon-box bg-primary text-primary-content w-8 h-8 text-base flex items-center justify-center">{#if icon}{icon}{:else}◈{/if}</span>
  <span class="brand-name text-base font-black tracking-tighter">{#if name}{name}{:else}Krewire{/if}</span>
  <span class="brand-badge badge badge-secondary font-mono text-2xs" {#if badgeI18n}data-i18n="{badgeI18n}"{/if}>{#if badge}{badge}{:else if version}{version}{:else}v0.1.0{/if}</span>
</a>
