<button type="button"
        class="lang-switch btn btn-outline {class}"
        {#if id}id="{id}"{/if}
        data-lang-toggle=""
        aria-label="{#if label}{label}{:else}Toggle language{/if}"
        onclick="{#if onClick}{onClick}{:else}window.krewireI18n && window.krewireI18n.toggle(){/if}"
        data-kiw-component="LangSwitch">
  <span class="lang-icon" aria-hidden="true">{#if icon}{icon}{:else}🌐{/if}</span>
  <span class="lang-code font-bold">{#if code}{code}{:else}EN{/if}</span>
</button>

<style>
.lang-switch {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.35rem 0.65rem;
  font-size: 0.8rem;
  min-height: 0;
  cursor: pointer;
  user-select: none;
}
.lang-icon {
  font-size: 0.9rem;
}
.lang-code {
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
}
</style>
