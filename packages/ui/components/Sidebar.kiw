<aside class="site-sidebar" id="site-sidebar" aria-label="Sidebar">
  <div class="sidebar-head flex items-center justify-between mb-3">
    <span class="sidebar-title text-xs font-black tracking-wider uppercase text-muted dark:text-muted-dark">{{if .Title}}{{.Title}}{{else}}Navigate{{end}}</span>
    <button class="md:hidden btn w-8 h-8 p-0 min-h-0 flex items-center justify-center text-lg sidebar-close" id="site-sidebar-close" aria-label="Close navigation">×</button>
  </div>
  {{if .Body}}
    {{.Body}}
  {{else}}
    <SideMenu />
  {{end}}
</aside>
<div class="sidebar-overlay" id="site-sidebar-overlay" aria-hidden="true"></div>

<style>
.site-sidebar {
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 0.92rem;
  background: var(--bg);
}
.sidebar-overlay {
  display: none;
}
@media (max-width: 63.99rem) {
  .site-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(82vw, 19rem);
    max-width: 19rem;
    padding: 1rem 1rem 2rem;
    background: var(--bg);
    border-right: var(--pop-border);
    box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    z-index: 60;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  html.sidebar-open .site-sidebar {
    transform: translateX(0);
  }
  html.sidebar-open .sidebar-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 55;
  }
}
@media (min-width: 64rem) {
  .site-sidebar {
    position: sticky;
    top: 4.5rem;
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    padding-right: 1.5rem;
  }
  .sidebar-close {
    display: none !important;
  }
}
</style>
