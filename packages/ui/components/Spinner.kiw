<span class="kiw-spinner {{if .Size}}kiw-spinner-{{.Size}}{{else}}kiw-spinner-md{{end}} {{.Class}}"
      {{with .ID}}id="{{.}}"{{end}}
      {{if .Label}}role="status" aria-label="{{.Label}}"{{else}}aria-hidden="true"{{end}}
      data-kiw-component="Spinner"></span>
{{if .Label}}
<span class="kiw-spinner-label {{.Class}}">{{.Label}}</span>
{{end}}

<style>
/* Pure CSS spinner: no keyframes asset and no JS, so it costs nothing on a page
   that only needs an indeterminate busy state. */
.kiw-spinner {
  display: inline-block;
  box-sizing: border-box;
  border-radius: 50%;
  border-style: solid;
  border-color: var(--border, #0B1F3B);
  border-top-color: transparent;
  animation: kiw-spin 0.7s linear infinite;
  vertical-align: middle;
}
.kiw-spinner-xs { width: 0.75rem; height: 0.75rem; border-width: 1.5px; }
.kiw-spinner-sm { width: 1rem; height: 1rem; border-width: 2px; }
.kiw-spinner-md { width: 1.5rem; height: 1.5rem; border-width: 2.5px; }
.kiw-spinner-lg { width: 2.25rem; height: 2.25rem; border-width: 3px; }

.kiw-spinner-label {
  margin-left: 0.5rem;
  font-size: 0.85rem;
  color: var(--muted, #57677d);
}

@keyframes kiw-spin {
  to { transform: rotate(360deg); }
}

/* Respect a reduced-motion preference: the spinner still communicates "busy",
   it simply stops spinning. */
@media (prefers-reduced-motion: reduce) {
  .kiw-spinner { animation-duration: 2.4s; }
}
</style>