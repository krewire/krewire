<div class="kiw-divider {{if .Vertical}}kiw-divider-vertical{{else}}kiw-divider-horizontal{{end}} {{.Class}}"
     role="separator"
     aria-orientation="{{if .Vertical}}vertical{{else}}horizontal{{end}}"
     data-kiw-component="Divider">
  {{if .Label}}
  <span class="kiw-divider-label">{{.Label}}</span>
  {{end}}
</div>

<style>
.kiw-divider {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.kiw-divider-horizontal {
  width: 100%;
  margin: 1.5rem 0;
  border-top: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
}
.kiw-divider-vertical {
  height: 100%;
  min-height: 1.5rem;
  margin: 0 1rem;
  border-left: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
}
.kiw-divider-label {
  padding: 0 0.75rem;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted, #57677d);
  background: var(--bg, #FAF8F4);
  transform: translateY(-50%);
  margin-left: auto;
  margin-right: auto;
}
</style>
