{{if .Ordered}}
<ol class="kiw-list {{if .Style}}kiw-list-{{.Style}}{{else}}kiw-list-decimal{{end}} {{if .Spacing}}kiw-list-gap-{{.Spacing}}{{else}}kiw-list-gap-sm{{end}} {{.Class}}"
    {{with .ID}}id="{{.}}"{{end}}
    data-kiw-component="List">
  {{.Body}}
</ol>
{{else}}
<ul class="kiw-list {{if .Style}}kiw-list-{{.Style}}{{else}}kiw-list-disc{{end}} {{if .Spacing}}kiw-list-gap-{{.Spacing}}{{else}}kiw-list-gap-sm{{end}} {{.Class}}"
    {{with .ID}}id="{{.}}"{{end}}
    data-kiw-component="List">
  {{.Body}}
</ul>
{{end}}

<style>
.kiw-list {
  box-sizing: border-box;
  color: var(--fg, #0B1F3B);
  font-size: 0.95rem;
  line-height: 1.6;
}
/* Markers: each <li> owns its own so a nested list can restyle independently. */
.kiw-list > li {
  margin-bottom: 0.25rem;
}
.kiw-list-disc { list-style: disc; padding-left: 1.5rem; }
.kiw-list-decimal { list-style: decimal; padding-left: 1.5rem; }
.kiw-list-none { list-style: none; padding-left: 0; }
.kiw-list-circle { list-style: circle; padding-left: 1.5rem; }
.kiw-list-square { list-style: square; padding-left: 1.5rem; }
/* A dash reads as secondary to the primary list, so nesting stays legible. */
.kiw-list-dash > li::marker { content: "— "; }

.kiw-list-gap-none > li { margin-bottom: 0; }
.kiw-list-gap-sm > li { margin-bottom: 0.25rem; }
.kiw-list-gap-md > li { margin-bottom: 0.5rem; }
.kiw-list-gap-lg > li { margin-bottom: 1rem; }

.kiw-list-muted { color: var(--muted, #57677d); }
.kiw-list-primary > li::marker { color: var(--primary, #39D353); }
</style>