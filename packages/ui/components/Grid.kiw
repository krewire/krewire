<div class="kiw-grid {{if .Cols}}kiw-grid-cols-{{.Cols}}{{else}}kiw-grid-cols-1{{end}} {{if .Gap}}kiw-grid-gap-{{.Gap}}{{else}}kiw-grid-gap-md{{end}} {{.Class}}"
     {{with .ID}}id="{{.}}"{{end}}
     data-kiw-component="Grid">
  {{.Body}}
</div>

<style>
.kiw-grid {
  display: grid;
  width: 100%;
  box-sizing: border-box;
}
.kiw-grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.kiw-grid-cols-2 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.kiw-grid-cols-3 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.kiw-grid-cols-4 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.kiw-grid-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }

@media (min-width: 640px) {
  .kiw-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .kiw-grid-cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .kiw-grid-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (min-width: 1024px) {
  .kiw-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .kiw-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

.kiw-grid-gap-none { gap: 0; }
.kiw-grid-gap-xs { gap: 0.5rem; }
.kiw-grid-gap-sm { gap: 0.75rem; }
.kiw-grid-gap-md { gap: 1.25rem; }
.kiw-grid-gap-lg { gap: 2rem; }
.kiw-grid-gap-xl { gap: 3rem; }
</style>
