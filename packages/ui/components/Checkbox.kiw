<label class="kiw-checkbox-label {{if .Disabled}}is-disabled{{end}} {{.Class}}" {{with .ID}}id="{{.}}-label"{{end}} data-kiw-component="Checkbox">
  <input
    type="checkbox"
    name="{{.Name}}"
    {{with .ID}}id="{{.}}"{{end}}
    {{with .Value}}value="{{.}}"{{end}}
    {{if .Checked}}checked{{end}}
    {{if .Required}}required{{end}}
    {{if .Disabled}}disabled{{end}}
    class="kiw-checkbox-input"
  >
  <span class="kiw-checkbox-box" aria-hidden="true">
    <svg class="kiw-checkbox-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
    </svg>
  </span>
  <span class="kiw-checkbox-text">{{if .Body}}{{.Body}}{{else}}{{.Label}}{{end}}</span>
</label>

<style>
.kiw-checkbox-label {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--fg, #0B1F3B);
  cursor: pointer;
  user-select: none;
}
.kiw-checkbox-label.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.kiw-checkbox-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  margin: 0;
}
.kiw-checkbox-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: var(--radius-sm, 5px);
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  background: var(--bg, #FAF8F4);
  box-shadow: var(--pop-sm, 2px 2px 0px var(--border, #0B1F3B));
  transition: background-color 0.15s ease, transform 0.1s ease;
  flex-shrink: 0;
}
.kiw-checkbox-icon {
  width: 0.85rem;
  height: 0.85rem;
  color: var(--primary-content, #0B1F3B);
  display: none;
}
.kiw-checkbox-input:checked + .kiw-checkbox-box {
  background: var(--primary, #39D353);
}
.kiw-checkbox-input:checked + .kiw-checkbox-box .kiw-checkbox-icon {
  display: block;
}
.kiw-checkbox-input:focus-visible + .kiw-checkbox-box {
  outline: 2px solid var(--primary, #39D353);
  outline-offset: 2px;
}
</style>
