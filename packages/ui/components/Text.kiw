{#if as == "span"}
<span class="kiw-text {#if size}kiw-text-{size}{/if} {#if color}kiw-text-{color}{/if} {#if weight}kiw-text-{weight}{/if} {class}" {#if id}id="{id}"{/if} data-kiw-component="Text">{#if body}{body}{:else}{text}{/if}</span>
{:else if as == "small"}
<small class="kiw-text {#if size}kiw-text-{size}{:else}kiw-text-sm{/if} {#if color}kiw-text-{color}{/if} {#if weight}kiw-text-{weight}{/if} {class}" {#if id}id="{id}"{/if} data-kiw-component="Text">{#if body}{body}{:else}{text}{/if}</small>
{:else if as == "strong"}
<strong class="kiw-text {#if size}kiw-text-{size}{/if} {#if color}kiw-text-{color}{/if} kiw-text-bold {class}" {#if id}id="{id}"{/if} data-kiw-component="Text">{#if body}{body}{:else}{text}{/if}</strong>
{:else}
<p class="kiw-text {#if size}kiw-text-{size}{/if} {#if color}kiw-text-{color}{/if} {#if weight}kiw-text-{weight}{/if} {class}" {#if id}id="{id}"{/if} data-kiw-component="Text">{#if body}{body}{:else}{text}{/if}</p>
{/if}

<style>
.kiw-text {
  font-family: inherit;
  line-height: 1.6;
  margin-top: 0;
  margin-bottom: 0.5rem;
}
.kiw-text-xs { font-size: 0.75rem; }
.kiw-text-sm { font-size: 0.875rem; }
.kiw-text-base { font-size: 1rem; }
.kiw-text-lg { font-size: 1.125rem; }
.kiw-text-xl { font-size: 1.25rem; }

.kiw-text-default { color: var(--fg, #0B1F3B); }
.kiw-text-muted { color: var(--muted, #57677d); }
.kiw-text-primary { color: var(--primary, #39D353); }
.kiw-text-error { color: var(--error, #FF3B2E); }

.kiw-text-normal { font-weight: 400; }
.kiw-text-medium { font-weight: 500; }
.kiw-text-semibold { font-weight: 600; }
.kiw-text-bold { font-weight: 700; }
</style>
