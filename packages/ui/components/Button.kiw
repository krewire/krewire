{#if href}
<a href="{href}" class="btn {#if variant}btn-{variant}{:else}btn-primary{/if} {#if size}btn-{size}{:else}btn-md{/if} {class}" {#if target}target="{target}" rel="noopener"{/if} {#if disabled}aria-disabled="true" tabindex="-1"{/if} {#if dataI18n}data-i18n="{dataI18n}"{/if}>
  {#if body}
    {body}
  {:else}
    {#if icon}<span class="btn-icon">{icon}</span>{/if}
    {#if text || label}<span class="btn-text">{#if text}{text}{:else}{label}{/if}</span>{/if}
    {#if iconRight}<span class="btn-icon-right">{iconRight}</span>{/if}
  {/if}
</a>
{:else}
<button type="{#if type}{type}{:else}button{/if}" class="btn {#if variant}btn-{variant}{:else}btn-primary{/if} {#if size}btn-{size}{:else}btn-md{/if} {class}" {#if disabled}disabled{/if} {#if onClick}onclick="{onClick}"{/if} {#if id}id="{id}"{/if} {#if ariaLabel}aria-label="{ariaLabel}"{/if} {#if ariaControls}aria-controls="{ariaControls}"{/if} {#if ariaExpanded}aria-expanded="{ariaExpanded}"{/if} {#if ariaPressed}aria-pressed="{ariaPressed}"{/if} {#if dataI18n}data-i18n="{dataI18n}"{/if}>
  {#if body}
    {body}
  {:else}
    {#if icon}<span class="btn-icon">{icon}</span>{/if}
    {#if text || label}<span class="btn-text">{#if text}{text}{:else}{label}{/if}</span>{/if}
    {#if iconRight}<span class="btn-icon-right">{iconRight}</span>{/if}
  {/if}
</button>
{/if}

<style>
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: inherit;
  font-weight: 800;
  border-radius: var(--radius, 10px);
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  box-shadow: var(--pop-shadow-sm, 2px 2px 0px var(--border, #0B1F3B));
  cursor: pointer;
  text-decoration: none;
  transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
  line-height: 1.2;
  white-space: nowrap;
  box-sizing: border-box;
}
.btn:hover:not(:disabled):not([aria-disabled="true"]) {
  transform: translate(-1.5px, -1.5px);
  box-shadow: var(--pop-shadow, 4px 4px 0px var(--border, #0B1F3B));
}
.btn:active:not(:disabled):not([aria-disabled="true"]) {
  transform: translate(0px, 0px);
  box-shadow: 1px 1px 0px var(--border, #0B1F3B);
}
.btn:disabled, .btn[aria-disabled="true"] {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}
/* Sizes */
.btn-sm { padding: 0.35rem 0.75rem; font-size: 0.8rem; }
.btn-md { padding: 0.55rem 1.15rem; font-size: 0.88rem; }
.btn-lg { padding: 0.75rem 1.6rem; font-size: 1rem; }

/* Variants */
.btn-primary {
  background: var(--primary, #39D353);
  color: var(--primary-content, #0B1F3B);
}
.btn-secondary {
  background: var(--secondary, #00D1C1);
  color: var(--secondary-content, #0B1F3B);
}
.btn-accent {
  background: var(--accent, #FF3B2E);
  color: #ffffff;
}
.btn-error {
  background: var(--error, #FF3B2E);
  color: #ffffff;
}
.btn-outline {
  background: var(--bg, #FAF8F4);
  color: var(--fg, #0B1F3B);
}
.btn-ghost {
  background: transparent;
  border-color: transparent;
  box-shadow: none;
  color: var(--fg, #0B1F3B);
}
.btn-ghost:hover:not(:disabled):not([aria-disabled="true"]) {
  background: var(--bg-2, #f0ede5);
  transform: none;
  box-shadow: none;
}
.btn-icon, .btn-icon-right {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
</style>
