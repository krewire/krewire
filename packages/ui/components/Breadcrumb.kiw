<nav class="kiw-breadcrumb {{.Class}}" {{with .ID}}id="{{.}}"{{end}} aria-label="{{with .Label}}{{.}}{{else}}Breadcrumb{{end}}" data-kiw-component="Breadcrumb">
  <ol class="kiw-breadcrumb-list">
    {{.Body}}
  </ol>
</nav>

<style>
/* Breadcrumb is a hierarchy, so the list is an ordered list and separators come
   from CSS ::after rather than markup — one source, no stray glyph to remove. */
.kiw-breadcrumb-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem;
  list-style: none;
  margin: 0 0 1rem;
  padding: 0;
  font-size: 0.85rem;
}
.kiw-breadcrumb-item {
  color: var(--muted, #57677d);
  text-decoration: none;
  padding: 0.15rem 0.25rem;
  border-radius: calc(var(--radius, 10px) * 0.4);
}
a.kiw-breadcrumb-item:hover {
  color: var(--fg, #0B1F3B);
  background: var(--bg-2, #f2ede4);
}
.kiw-breadcrumb-item:focus-visible { outline: 2px solid var(--primary, #39D353); outline-offset: 2px; }
/* The last item is the current page: it is not a link and reads at full weight. */
.kiw-breadcrumb-item.is-current,
.kiw-breadcrumb-item[aria-current="page"] {
  color: var(--fg, #0B1F3B);
  font-weight: 700;
  cursor: default;
}
.kiw-breadcrumb-item[aria-current="page"]::after,
.kiw-breadcrumb-item.is-current::after { content: none; }
.kiw-breadcrumb-list > li:not(:last-child) > .kiw-breadcrumb-item::after {
  content: "/";
  margin-left: 0.35rem;
  color: var(--border, #0B1F3B);
}
</style>