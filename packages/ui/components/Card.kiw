<div class="{{class "card" .Variant "default" .Class}}">
  {#if title || badge}
  <div class="card-head">
    <div class="card-titles">
      {#if title}<h3 class="card-title">{title}</h3>{/if}
      {#if subtitle}<p class="card-subtitle">{subtitle}</p>{/if}
    </div>
    {#if badge}
    <span class="card-badge">{badge}</span>
    {/if}
  </div>
  {/if}
  {#if body}
  <div class="card-body">{body}</div>
  {/if}
  {#if footer}
  <div class="card-footer">{footer}</div>
  {/if}
</div>

<style>
.card {
  background: var(--bg, #FAF8F4);
  border: var(--pop-border, 2.5px solid var(--border, #0B1F3B));
  border-radius: var(--radius, 14px);
  box-shadow: var(--pop-shadow, 4px 4px 0px var(--border, #0B1F3B));
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  box-sizing: border-box;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.card:hover {
  transform: translate(-1.5px, -1.5px);
  box-shadow: var(--pop-shadow-lg, 6px 6px 0px var(--border, #0B1F3B));
}
.card-featured {
  border-color: var(--primary, #39D353);
  box-shadow: 4px 4px 0px var(--primary, #39D353);
}
.card-subtle {
  background: var(--bg-2, #f0ede5);
  box-shadow: var(--pop-shadow-sm, 2px 2px 0px var(--border, #0B1F3B));
}
.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  border-bottom: 1.5px solid var(--border-subtle, rgba(11,31,59,.15));
  padding-bottom: 0.65rem;
}
.card-titles {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.card-title {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--fg, #0B1F3B);
}
.card-subtitle {
  margin: 0;
  font-size: 0.85rem;
  color: var(--muted, #475569);
  line-height: 1.4;
}
.card-badge {
  font-size: 0.72rem;
  font-weight: 800;
  font-family: ui-monospace, monospace;
  padding: 0.2rem 0.55rem;
  border-radius: 6px;
  background: var(--bg-2, #f0ede5);
  border: 1px solid var(--border, #0B1F3B);
  color: var(--fg, #0B1F3B);
  white-space: nowrap;
}
.card-body {
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--fg, #0B1F3B);
}
.card-footer {
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1.5px solid var(--border-subtle, rgba(11,31,59,.15));
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
}
</style>
