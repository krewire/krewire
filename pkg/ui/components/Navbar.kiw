<header class="sticky top-0 z-50 bg-bg dark:bg-bg-dark border-b border-pop w-full navbar" style="border-bottom:var(--pop-border)">
  <div class="container-site flex items-center justify-between gap-3 py-3">
    <div class="flex items-center gap-3 min-w-0">
      {#if showSidebarToggle}
      <Hamburger ID="site-sidebar-toggle" Label="Open navigation" Controls="site-sidebar" DataDrawerToggle="site-sidebar" Class="lg:hidden sidebar-toggle shrink-0" />
      {/if}
      {#if brand}
        {brand}
      {:else}
        <Brand Name={brandName} Href={brandHref} Icon={brandIcon} {version} Badge={brandBadge} BadgeI18n={brandBadgeI18n} />
      {/if}
    </div>

    <!-- Main / Desktop navigation slot -->
    <div class="ml-auto hidden lg:flex items-center gap-1 nav-menu">
      {#if body}
        {body}
      {:else if navLinks}
        {#each navLinks as link}
          <a href="{link.url}" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">{link.text}</a>
        {/each}
      {:else if showEcosystemMenu}
        <NavMenu />
      {/if}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      {#if actions}
        {actions}
      {/if}
      {#if showLangToggle}
      <LangSwitch />
      {/if}
      {#if !hideGitHub && gitHubURL}
      <a href="{gitHubURL}" target="_blank" rel="noopener"
         class="hidden lg:inline-flex items-center gap-1.5 btn btn-primary text-xs px-4 py-2 min-h-0">
        <span>★</span><span>GitHub</span>
      </a>
      {/if}
      <ThemeSwitch />
      <Hamburger ID="nav-toggler" Label="Toggle menu" Controls="nav-mobile-menu" DataDrawerToggle="nav-mobile-menu" Class="lg:hidden shrink-0" />
    </div>
  </div>

  <!-- Mobile navigation drawer -->
  <div id="nav-mobile-menu" class="drawer drawer-right lg:hidden" role="dialog" aria-modal="true" aria-label="Menu" data-kiw-component="Drawer">
    <div class="drawer-panel">
      <div class="drawer-head">
        <div class="drawer-title-area">
          <h3 class="drawer-title">Menu</h3>
        </div>
        <button type="button" class="drawer-close" aria-label="Close drawer" data-drawer-close="nav-mobile-menu">
          ✕
        </button>
      </div>

      <div class="drawer-body">
        <div class="flex flex-col gap-1.5 mobile-nav-items">
          {#if drawer}
            {drawer}
          {:else if drawerBody}
            {drawerBody}
          {:else if body}
            {body}
          {:else if navLinks}
            {#each navLinks as link}
              <a href="{link.url}" class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">{link.text}</a>
            {/each}
          {:else if showEcosystemMenu}
            <div class="px-3 py-1 text-2xs font-black uppercase tracking-wider text-muted dark:text-muted-dark" data-i18n="nav.products">Products</div>
            <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
              <span class="flex items-center gap-2.5">
                <span class="icon-box bg-secondary text-xs w-6 h-6 shrink-0 flex items-center justify-center">⚡</span>
                <span>Krewire Workspace</span>
              </span>
              <span class="text-2xs badge badge-secondary">AI</span>
            </a>
            <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
              <span class="flex items-center gap-2.5">
                <span class="icon-box bg-primary text-xs w-6 h-6 shrink-0 flex items-center justify-center">◈</span>
                <span>Krewire Cloud</span>
              </span>
              <span class="text-2xs badge badge-primary">PaaS</span>
            </a>
            <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
              <span class="flex items-center gap-2.5">
                <span class="icon-box bg-[#FFD000] text-xs w-6 h-6 shrink-0 flex items-center justify-center">🛡</span>
                <span>Krewire Auth</span>
              </span>
              <span class="text-2xs badge badge-muted">ID</span>
            </a>
            <a href="https://panel.krewire.com" target="_blank" rel="noopener" class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all">
              <span class="flex items-center gap-2.5">
                <span class="icon-box bg-[#00D1C1] text-xs w-6 h-6 shrink-0 flex items-center justify-center">🎛</span>
                <span>Krewire Panel</span>
              </span>
              <span class="text-2xs badge badge-secondary">Host</span>
            </a>
            <hr class="my-2" style="border-color:var(--pop-border); border-width:1.5px">
            <a href="/docs/getting-started" class="mobile-link flex items-center gap-3 px-3 py-3 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all duration-150">
              <span class="text-primary w-4 font-black">›</span> <span data-i18n="nav.get_started">Get Started</span>
            </a>
            <a href="/docs/workloads" class="mobile-link flex items-center gap-3 px-3 py-3 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all duration-150">
              <span class="text-primary w-4 font-black">▦</span> <span data-i18n="nav.workloads">8 Workloads</span>
            </a>
            <a href="/docs/getting-started/dsl" class="mobile-link flex items-center gap-3 px-3 py-3 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all duration-150">
              <span class="text-primary w-4 font-black">◈</span> <span data-i18n="nav.dsl">Component DSL</span>
            </a>
            <a href="/docs" class="mobile-link flex items-center gap-3 px-3 py-3 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all duration-150">
              <span class="text-primary w-4 font-black">≡</span> <span data-i18n="nav.docs">Documentation</span>
            </a>
            <a href="/#ecosystem" class="mobile-link flex items-center gap-3 px-3 py-3 rounded-lg font-extrabold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all duration-150">
              <span class="text-primary w-4 font-black">⬢</span> <span data-i18n="nav.ecosystem">Ecosystem</span>
            </a>
          {/if}
        </div>
      </div>
    </div>
  </div>
  <div id="nav-mobile-menu-backdrop" class="drawer-backdrop lg:hidden" data-drawer-backdrop="nav-mobile-menu" aria-hidden="true"></div>
</header>
