<section id="ecosystem" class="w-full bg-bg-2 dark:bg-bg-dark-2 py-10 sm:py-12 md:py-14 lg:py-16 {class}" style="border-top:var(--pop-border); border-bottom:var(--pop-border)" data-kiw-component="Ecosystem">
  <div class="container-site">
    <div class="section-head mb-6 sm:mb-8">
      <span class="badge badge-primary mb-3" data-i18n="ecosystem.badge">Official Ecosystem</span>
      <h2 class="w-full max-w-3xl mx-auto text-center font-black tracking-tight mb-2 text-fg dark:text-fg-dark" data-i18n="ecosystem.title">Unified Multi-Repo Architecture</h2>
      <p class="w-full max-w-2xl mx-auto text-center text-sm md:text-base text-muted dark:text-muted-dark" data-i18n="ecosystem.lead">The Krewire digital SDLC platform is organized into focused, independent repositories that compose cleanly.</p>
    </div>

    <!-- Grid: 1 col on mobile → 2 col on sm → 3 col on lg -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4 md:gap-4 lg:gap-5">

      <!-- 1. krewire -->
      <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150 word-break-all bg-bg dark:bg-bg-dark"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge badge-primary text-2xs font-mono" data-i18n="ecosystem.core_badge">Core Monorepo</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">krewire</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3" data-i18n="ecosystem.core_desc">Modular Go packages (pkg/*), devtool CLI (kiw), WebAssembly web runtime, ORM, and Boost AI agents.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/krewire</code>
        </div>
      </a>

      <!-- 2. cloud -->
      <a href="https://github.com/krewire/cloud" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150 bg-bg dark:bg-bg-dark"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge badge-secondary text-2xs font-mono" data-i18n="ecosystem.cloud_badge">Hybrid PaaS</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">cloud</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3" data-i18n="ecosystem.cloud_desc">Self-hosted PaaS engine, multi-tenant cloud control plane, hermetic builder, and dynamic edge reverse proxy.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/cloud</code>
        </div>
      </a>

      <!-- 3. auth -->
      <a href="https://github.com/krewire/auth" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150 bg-bg dark:bg-bg-dark"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge text-2xs font-mono" style="background:#8B5CF6; color:#ffffff; border:var(--pop-border-thin); box-shadow:var(--pop-shadow-sm)" data-i18n="ecosystem.auth_badge">Enterprise Auth</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">auth</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3" data-i18n="ecosystem.auth_desc">Multi-tenant identity, Single Sign-On (OIDC/SAML2), MFA (TOTP), reset password, and hierarchical RBAC.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/auth</code>
        </div>
      </a>

      <!-- 4. dash -->
      <a href="https://github.com/krewire/dash" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150 bg-bg dark:bg-bg-dark"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge badge-secondary text-2xs font-mono" data-i18n="ecosystem.dash_badge">Virtual Workspace</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">dash</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3" data-i18n="ecosystem.dash_desc">AI-powered virtual workspace for integration, automation, sandboxed cloud runtimes, and collaborative engineering.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/dash</code>
        </div>
      </a>

      <!-- 5. krewire.com -->
      <a href="https://github.com/krewire/krewire.com" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150 bg-bg dark:bg-bg-dark"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge badge-muted text-2xs font-mono" data-i18n="ecosystem.portal_badge">Portal Site</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">krewire.com</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3" data-i18n="ecosystem.portal_desc">Official production website and documentation portal built with site kind & .kiw DSL.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/krewire.com</code>
        </div>
      </a>

      <!-- 6. krewire.github.io -->
      <a href="https://github.com/krewire/krewire.github.io" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150 bg-bg dark:bg-bg-dark"
         style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge text-2xs font-mono" style="background:#FF3B2E; color:#ffffff; border:var(--pop-border-thin); box-shadow:var(--pop-shadow-sm)" data-i18n="ecosystem.community_badge">Community</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">krewire.github.io</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3" data-i18n="ecosystem.community_desc">Community portal for contributors, guides, release announcements, and sponsorships.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/krewire.github.io</code>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
.eco-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.eco-card:hover .eco-arrow {
  transform: translate(2px, -2px);
  color: var(--primary);
}
</style>
