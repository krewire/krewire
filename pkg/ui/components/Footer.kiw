{#if body}
<footer class="bg-bg-2 dark:bg-bg-dark-2 {class}" style="border-top:var(--pop-border)" data-kiw-component="Footer">
  <div class="container-site pt-12 pb-8">
    {body}
  </div>
</footer>
{:else if variant == "simple"}
<footer class="bg-bg-2 dark:bg-bg-dark-2 py-6 text-xs text-muted dark:text-muted-dark {class}" style="border-top:1px solid var(--border)" data-kiw-component="Footer">
  <div class="container-site flex flex-wrap items-center justify-between gap-3">
    <span>{#if copyrightText}{copyrightText}{:else}© 2026 {#if brandName}{brandName}{:else}Krewire Contributors{/if}{/if}</span>
    {#if bottom}
      {bottom}
    {:else if gitHubURL}
      <span><a href="{gitHubURL}" target="_blank" rel="noopener" class="hover:text-primary transition-colors">{gitHubURL}</a></span>
    {/if}
  </div>
</footer>
{:else if variant == "contributors"}
<footer class="bg-bg-2 dark:bg-bg-dark-2 footer {class}" style="border-top:var(--pop-border)" data-kiw-component="Footer">
  <div class="container-site pt-12 pb-8 footer-inner">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-8 footer-grid" style="border-bottom:var(--pop-border-thin)">
      <!-- Brand col -->
      <div class="sm:col-span-2 md:col-span-1">
        {#if brand}
          {brand}
        {:else}
          <div class="flex items-center gap-2 font-black text-lg mb-3 footer-brand">
            <span class="icon-box bg-primary text-primary-content w-7 h-7 text-sm flex items-center justify-center brand-mark">{#if brandIcon}{brandIcon}{:else}◈{/if}</span>
            <span data-i18n="footer.brand_title">{#if brandName}{brandName}{:else}Krewire Contributors{/if}</span>
          </div>
          <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-4 footer-desc" data-i18n-html="footer.desc_html">
            {#if brandTagline}{brandTagline}{:else}Home of the Open Source Collective.<br>Crafting an autonomous, sustainable, and scalable Go ecosystem at near-zero cost.{/if}
          </p>
        {/if}
      </div>

      <!-- Repositories & Products col -->
      <div class="flex flex-col gap-2 footer-col">
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1" data-i18n="footer.products_title">Products</strong>
        <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Workspace</a>
        <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Cloud</a>
        <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Auth</a>
        <a href="https://panel.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Panel</a>
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mt-2 mb-1" data-i18n="footer.col_repos">Open Source Repos</strong>
        <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krewire (core monorepo)</a>
        <a href="https://github.com/krewire/krew" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krew (AI agent)</a>
        <a href="https://github.com/krewire/dash" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">dash (workspace runtime)</a>
        <a href="https://github.com/krewire/krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krewire.com (portal)</a>
        <a href="https://github.com/krewire/krewire.github.io" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krewire.github.io (community)</a>
      </div>

      <!-- Contribution col -->
      <div class="flex flex-col gap-2 footer-col">
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1" data-i18n="footer.col_contrib">Contribution</strong>
        <a href="#benefits" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.perks">Contributor Perks &amp; Access</a>
        <a href="#where-to-start" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.where_start">Where to Start</a>
        <a href="/docs/getting-started" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.getting_started">Getting Started</a>
        <a href="#pathways" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.pathways">Contribution Pathways</a>
        <a href="#standards" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.standards">The Krewire Way</a>
      </div>

      <!-- Community col -->
      <div class="flex flex-col gap-2 footer-col">
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1" data-i18n="footer.col_community">Community</strong>
        <a href="https://github.com/krewire" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.gh_org">GitHub Organization</a>
        <a href="https://github.com/orgs/krewire/discussions" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.discussions">Discussions</a>
        <a href="https://github.com/krewire/krewire/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.good_first">Good First Issues</a>
        <a href="https://github.com/krewire/.github/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors" data-i18n="footer.coc">Code of Conduct</a>
      </div>
    </div>

    <!-- Footer bottom -->
    <div class="pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 text-xs font-semibold text-muted dark:text-muted-dark footer-bottom">
      {#if bottom}
        {bottom}
      {:else}
        <span data-i18n-html="footer.bottom_rights_html">© 2026 {#if brandName}{brandName}{:else}Krewire Contributors{/if} — Built 100% with Krewire <code class="code-inline">site</code> workload.</span>
        <a href="https://github.com/krewire" target="_blank" rel="noopener" class="hover:text-primary transition-colors">github.com/krewire</a>
      {/if}
    </div>
  </div>
</footer>
{:else}
<footer class="bg-bg-2 dark:bg-bg-dark-2 {class}" style="border-top:var(--pop-border)" data-kiw-component="Footer">
  <div class="container-site pt-12 pb-8">
    {#if columns}
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-8" style="border-bottom:var(--pop-border-thin)">
        {#if brand}
          <div class="sm:col-span-2 md:col-span-1">
            {brand}
          </div>
        {:else if brandName}
          <div class="sm:col-span-2 md:col-span-1">
            <div class="flex items-center gap-2 font-black text-lg mb-3">
              <span class="icon-box bg-primary text-primary-content w-7 h-7 text-sm flex items-center justify-center">{#if brandIcon}{brandIcon}{:else}◈{/if}</span>
              <span>{brandName}</span>
            </div>
            {#if brandTagline}
              <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-4">{brandTagline}</p>
            {/if}
            {#if brandBadge}
              <span class="badge badge-secondary text-2xs">{brandBadge}</span>
            {/if}
          </div>
        {/if}
        {columns}
      </div>
    {:else}
      <!-- Standard Footer grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-8" style="border-bottom:var(--pop-border-thin)">
        <!-- Brand col -->
        <div class="sm:col-span-2 md:col-span-1">
          {#if brand}
            {brand}
          {:else}
            <div class="flex items-center gap-2 font-black text-lg mb-3">
              <span class="icon-box bg-primary text-primary-content w-7 h-7 text-sm flex items-center justify-center">{#if brandIcon}{brandIcon}{:else}◈{/if}</span>
              <span>{#if brandName}{brandName}{:else}Krewire{/if}</span>
            </div>
            <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-4" data-i18n-html="footer.tagline_html">
              {#if brandTagline}{brandTagline}{:else}Modular Go Libraries for Every Workload.<br>One CLI <code class="code-inline">kiw</code>, one config <code class="code-inline">krewire.yaml</code>.{/if}
            </p>
            {#if !hideBadge}
              <span class="badge badge-secondary text-2xs" data-i18n="footer.badge">{#if brandBadge}{brandBadge}{:else}Compiled Go · Zero Bloat{/if}</span>
            {/if}
          {/if}
        </div>

        {#if showEcosystemFooter}
          <!-- Workloads col -->
          <div class="flex flex-col gap-2">
            <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1" data-i18n="footer.workloads_title">8 Workloads</strong>
            <a href="/docs/workloads/app" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">app — Fullstack Monolith</a>
            <a href="/docs/workloads/cli" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">cli — Terminal TUI</a>
            <a href="/docs/workloads/site" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">site — Scoped SSG</a>
            <a href="/docs/workloads/book" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">book — Docs &amp; Books</a>
            <a href="/docs/workloads/worker" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">worker — Async Queues</a>
            <a href="/docs/workloads/service" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">service — Microservices</a>
            <a href="/docs/workloads/infra" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">infra — Cloud IaC</a>
            <a href="/docs/workloads/gateway" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">gateway — Reverse Proxy</a>
          </div>

          <!-- Docs col -->
          <div class="flex flex-col gap-2">
            <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1" data-i18n="footer.docs_title">Documentation</strong>
            <a href="/docs/overview" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">1. Overview</a>
            <a href="/docs/getting-started" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">2. Getting Started</a>
            <a href="/docs/workloads" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">3. Workloads in Depth</a>
            <a href="/docs/cli-reference" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">4. CLI Reference</a>
            <a href="/docs/packages" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">5. Packages &amp; Libraries</a>
            <a href="/docs/guides" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">6. Architecture &amp; Guides</a>
          </div>

          <!-- Products & Repos col -->
          <div class="flex flex-col gap-2">
            <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1" data-i18n="footer.products_title">Products</strong>
            <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Workspace</a>
            <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Cloud</a>
            <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Auth</a>
            <a href="https://panel.krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">Panel</a>
            <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mt-2 mb-1" data-i18n="footer.ecosystem_title">Open Source Repos</strong>
            <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krewire (core monorepo)</a>
            <a href="https://github.com/krewire/krew" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krew (AI agent)</a>
            <a href="https://github.com/krewire/dash" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">dash (workspace runtime)</a>
            <a href="https://github.com/krewire/krewire.com" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krewire.com (portal)</a>
            <a href="https://github.com/krewire/krewire.github.io" target="_blank" rel="noopener" class="text-sm font-semibold text-muted dark:text-muted-dark hover:text-primary transition-colors">krewire.github.io (community)</a>
          </div>
        {/if}
      </div>
    {/if}

    <!-- Footer bottom -->
    <div class="pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 text-xs font-semibold text-muted dark:text-muted-dark">
      {#if bottom}
        {bottom}
      {:else}
        <span data-i18n-html="footer.copyright_html">© 2026 {#if brandName}{brandName}{:else}Krewire Contributors{/if} — Built with Krewire <code class="code-inline">site</code> workload.</span>
        {#if !hideGitHub}
          <a href="{#if gitHubURL}{gitHubURL}{:else}https://github.com/krewire{/if}" target="_blank" rel="noopener" class="hover:text-primary transition-colors">github.com/krewire</a>
        {/if}
      {/if}
    </div>
  </div>
</footer>
{/if}
