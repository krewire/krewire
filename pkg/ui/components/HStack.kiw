<div class="kiw-hstack {#if gap}kiw-gap-{gap}{:else}kiw-gap-md{/if} {#if align}kiw-align-{align}{:else}kiw-align-center{/if} {#if justify}kiw-justify-{justify}{/if} {#if noWrap || nowrap}kiw-nowrap{:else}kiw-wrap{/if} {class}"
     {#if id}id="{id}"{/if}
     data-kiw-component="HStack">
  {body}
</div>

<style>
.kiw-hstack {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
}

.kiw-wrap { flex-wrap: wrap; }
.kiw-nowrap { flex-wrap: nowrap; }

.kiw-gap-none { gap: 0; }
.kiw-gap-xs { gap: 0.25rem; }
.kiw-gap-sm { gap: 0.5rem; }
.kiw-gap-md { gap: 0.75rem; }
.kiw-gap-lg { gap: 1.25rem; }
.kiw-gap-xl { gap: 2rem; }
.kiw-gap-2xl { gap: 3rem; }

.kiw-align-start { align-items: flex-start; }
.kiw-align-center { align-items: center; }
.kiw-align-end { align-items: flex-end; }
.kiw-align-stretch { align-items: stretch; }
.kiw-align-baseline { align-items: baseline; }

.kiw-justify-start { justify-content: flex-start; }
.kiw-justify-center { justify-content: center; }
.kiw-justify-end { justify-content: flex-end; }
.kiw-justify-between { justify-content: space-between; }
.kiw-justify-around { justify-content: space-around; }
.kiw-justify-evenly { justify-content: space-evenly; }
</style>
