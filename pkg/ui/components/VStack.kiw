<div class="kiw-vstack {#if gap}kiw-gap-{gap}{:else}kiw-gap-md{/if} {#if align}kiw-align-{align}{:else}kiw-align-stretch{/if} {#if justify}kiw-justify-{justify}{/if} {class}"
     {#if id}id="{id}"{/if}
     data-kiw-component="VStack">
  {body}
</div>

<style>
.kiw-vstack {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
  min-width: 0;
  width: 100%;
}

.kiw-gap-none { gap: 0; }
.kiw-gap-xs { gap: 0.25rem; }
.kiw-gap-sm { gap: 0.5rem; }
.kiw-gap-md { gap: 1rem; }
.kiw-gap-lg { gap: 1.5rem; }
.kiw-gap-xl { gap: 2rem; }
.kiw-gap-2xl { gap: 3rem; }

.kiw-align-start { align-items: flex-start; }
.kiw-align-center { align-items: center; }
.kiw-align-end { align-items: flex-end; }
.kiw-align-stretch { align-items: stretch; }

.kiw-justify-start { justify-content: flex-start; }
.kiw-justify-center { justify-content: center; }
.kiw-justify-end { justify-content: flex-end; }
.kiw-justify-between { justify-content: space-between; }
</style>
