<div class="kiw-stack {#if direction}kiw-stack-{direction}{:else}kiw-stack-col{/if} {#if gap}kiw-stack-gap-{gap}{:else}kiw-stack-gap-md{/if} {#if align}kiw-stack-align-{align}{/if} {#if justify}kiw-stack-justify-{justify}{/if} {#if wrap}kiw-stack-wrap{/if} {class}"
     {#if id}id="{id}"{/if}
     data-kiw-component="Stack">
  {body}
</div>

<style>
.kiw-stack {
  display: flex;
  box-sizing: border-box;
}
.kiw-stack-col { flex-direction: column; }
.kiw-stack-row { flex-direction: row; }

.kiw-stack-wrap { flex-wrap: wrap; }

.kiw-stack-gap-none { gap: 0; }
.kiw-stack-gap-xs { gap: 0.25rem; }
.kiw-stack-gap-sm { gap: 0.5rem; }
.kiw-stack-gap-md { gap: 1rem; }
.kiw-stack-gap-lg { gap: 1.5rem; }
.kiw-stack-gap-xl { gap: 2rem; }

.kiw-stack-align-start { align-items: flex-start; }
.kiw-stack-align-center { align-items: center; }
.kiw-stack-align-end { align-items: flex-end; }
.kiw-stack-align-stretch { align-items: stretch; }

.kiw-stack-justify-start { justify-content: flex-start; }
.kiw-stack-justify-center { justify-content: center; }
.kiw-stack-justify-end { justify-content: flex-end; }
.kiw-stack-justify-between { justify-content: space-between; }
</style>
