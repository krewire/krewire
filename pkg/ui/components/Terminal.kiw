<div class="terminal flex items-center gap-2.5 rounded-[10px] px-3.5 py-2.5 bg-bg-2 dark:bg-bg-dark-2 overflow-x-auto {class}"
     style="border:var(--pop-border); box-shadow:var(--pop-shadow-sm)"
     {#if id}id="{id}"{/if}
     data-kiw-component="Terminal">
  <span class="font-mono font-black {#if promptColor == "muted"}text-muted dark:text-muted-dark{:else}text-primary{/if} text-sm shrink-0 select-none">{#if prompt}{prompt}{:else}${/if}</span>
  <code class="font-mono text-xs font-bold text-fg dark:text-fg-dark whitespace-nowrap flex-1">{#if command}{command}{:else if body}{body}{/if}</code>
  {#if command}
  <button type="button"
          class="btn-copy shrink-0 text-xs font-black px-2.5 py-1 rounded-md bg-secondary text-secondary-content transition-all duration-150 cursor-pointer hover:bg-primary"
          style="border:var(--pop-border-thin); box-shadow:1.5px 1.5px 0px var(--border)"
          onclick="copyCmd(this, '{command}')">Copy</button>
  {/if}
</div>

<style>
.terminal {
  box-sizing: border-box;
  max-width: 100%;
}
.btn-copy:hover {
  transform: translate(-1px, -1px);
  box-shadow: 2.5px 2.5px 0px var(--border);
}
.btn-copy:active {
  transform: translate(0px, 0px);
  box-shadow: 1px 1px 0px var(--border);
}
</style>
