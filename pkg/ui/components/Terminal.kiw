<div class="terminal relative flex items-center rounded-[10px] bg-bg-2 dark:bg-bg-dark-2 {class}"
     style="border:var(--pop-border); box-shadow:var(--pop-shadow-sm)"
     {#if id}id="{id}"{/if}
     data-kiw-component="Terminal">
  <div class="terminal-body flex items-center gap-2.5 px-3.5 py-2.5 overflow-x-auto flex-1 min-w-0 {#if command}pr-16{/if}">
    <span class="font-mono font-black {#if promptColor == "muted"}text-muted dark:text-muted-dark{:else}text-primary{/if} text-sm shrink-0 select-none">{#if prompt}{prompt}{:else}${/if}</span>
    <code class="font-mono text-xs font-bold text-fg dark:text-fg-dark whitespace-nowrap">{#if command}{command}{:else if body}{body}{/if}</code>
  </div>
  {#if command}
  <button type="button"
          class="btn-copy shrink-0 text-xs font-black px-2.5 py-1 rounded-md bg-secondary text-secondary-content transition-all duration-150 cursor-pointer hover:bg-primary z-10"
          style="border:var(--pop-border-thin); box-shadow:1.5px 1.5px 0px var(--border)"
          onclick="copyCmd(this, '{command}')">Copy</button>
  {/if}
</div>

<style>
.terminal {
  position: relative;
  box-sizing: border-box;
  max-width: 100%;
}
.btn-copy {
  position: absolute;
  right: 0.625rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}
.btn-copy:hover {
  transform: translateY(-50%) translate(-1px, -1px);
  box-shadow: 2.5px 2.5px 0px var(--border);
}
.btn-copy:active {
  transform: translateY(-50%) translate(0px, 0px);
  box-shadow: 1px 1px 0px var(--border);
}
</style>
