  "$id": "https://krewire.dev/schemas/toolchain/v1/Policy.json",
  "$ref": "#/$defs/Policy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Krewire toolchain contract Policy, toolchain.krewire.dev/v1 (contract 1.0.0).",
  "title": "Policy"
