{
  "$defs": {
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "toolchain.krewire.dev/v1"
        },
        "digest": {
          "type": "string"
        },
        "kind": {
          "const": "Plan"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "kind",
        "task_id",
        "summary",
        "steps"
      ],
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "rollback": {
          "type": "string"
        },
        "target_files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "target_files",
        "risk"
      ],
      "type": "object"
    }
  },
  "$id": "https://krewire.dev/schemas/toolchain/v1/Plan.json",
  "$ref": "#/$defs/Plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Krewire toolchain contract Plan, toolchain.krewire.dev/v1 (contract 1.0.0).",
  "title": "Plan"
}
