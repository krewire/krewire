<span class="badge {{if .Variant}}badge-{{.Variant}}{{else}}badge-neutral{{end}} {{if .Size}}badge-{{.Size}}{{else}}badge-md{{end}} {{.Class}}">
  {{if .Dot}}<span class="badge-dot" aria-hidden="true"></span>{{end}}
  <span class="badge-text">{{.Text}}</span>
</span>

<style>
.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-weight: 800;
  border-radius: 999px;
  border: 1.5px solid var(--border, #0B1F3B);
  box-shadow: 1.5px 1.5px 0px var(--border, #0B1F3B);
  line-height: 1;
  white-space: nowrap;
  letter-spacing: 0.02em;
}
.badge-sm { padding: 0.15rem 0.45rem; font-size: 0.7rem; }
.badge-md { padding: 0.25rem 0.65rem; font-size: 0.78rem; }

.badge-neutral {
  background: var(--bg-2, #f0ede5);
  color: var(--fg, #0B1F3B);
}
.badge-primary {
  background: var(--primary, #39D353);
  color: var(--primary-content, #0B1F3B);
}
.badge-secondary {
  background: var(--secondary, #00D1C1);
  color: var(--secondary-content, #0B1F3B);
}
.badge-accent {
  background: var(--accent, #FF3B2E);
  color: #ffffff;
}
.badge-success {
  background: var(--success, #39D353);
  color: var(--primary-content, #0B1F3B);
}
.badge-warning {
  background: var(--warning, #ffb703);
  color: #0B1F3B;
}
.badge-danger {
  background: var(--error, #FF3B2E);
  color: #ffffff;
}

.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  display: inline-block;
}
</style>
