{{if eq .Variant "simple"}}
<footer class="footer-simple">
  <div class="footer-simple-inner">
    <span>© 2026 Krewire Contributors — Built 100% with Krewire `site` workload.</span>
    <span><a href="https://github.com/krewire">github.com/krewire</a> · <a href="/getting-started">Get Started</a></span>
  </div>
</footer>
{{else}}
<footer class="footer-full">
  <div class="container-site pt-12 pb-8">
    <!-- Footer grid: 1 col → sm: 2 col → md: 4 col -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-8" style="border-bottom:var(--pop-border-thin)">
      <!-- Brand col -->
      <div class="sm:col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 font-black text-lg mb-3">
          <span class="brand-icon">◈</span>
          <span>Krewire</span>
        </div>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed mb-4">
          One Go Framework for Every Workload.<br>
          One CLI <code class="code-inline">kiw</code>, one config <code class="code-inline">krewire.yaml</code>.
        </p>
        <span class="badge badge-secondary text-2xs">Compiled Go · Zero Bloat</span>
      </div>

      <!-- Workloads col -->
      <div class="flex flex-col gap-2">
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1">8 Workloads</strong>
        <a href="/docs/krewire-workloads#1-fullstack-monolith-app" class="footer-link">app — Fullstack Monolith</a>
        <a href="/docs/krewire-workloads#2-terminal-cli--tui-cli" class="footer-link">cli — Terminal TUI</a>
        <a href="/docs/krewire-workloads#3-static-site-generator-site" class="footer-link">site — Scoped SSG</a>
        <a href="/docs/krewire-workloads#4-technical-book-book" class="footer-link">book — Docs &amp; Books</a>
        <a href="/docs/krewire-workloads#5-background-worker-worker" class="footer-link">worker — Async Queues</a>
        <a href="/docs/krewire-workloads#6-microservice-service" class="footer-link">service — Microservices</a>
        <a href="/docs/krewire-workloads#7-cloud-infrastructure-as-code-infra" class="footer-link">infra — Cloud IaC</a>
        <a href="/docs/krewire-workloads#8-webassembly-runtime-runtime" class="footer-link">runtime — Go WASM</a>
      </div>

      <!-- Docs col -->
      <div class="flex flex-col gap-2">
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1">Documentation</strong>
        <a href="/docs/krewire-framework" class="footer-link">1.1 Krewire Framework</a>
        <a href="/docs/why-krewire" class="footer-link">1.2 Why Krewire?</a>
        <a href="/docs/krewire-workloads" class="footer-link">1.3 Krewire Workloads</a>
        <a href="/docs/upgrade-guide" class="footer-link">1.4 Upgrade Guide</a>
        <a href="/getting-started" class="footer-link">2. Getting Started →</a>
        <a href="https://github.com/krewire/framework/tree/main/docs/specs" target="_blank" rel="noopener" class="footer-link">Engineering Specs</a>
      </div>

      <!-- Ecosystem col -->
      <div class="flex flex-col gap-2">
        <strong class="text-2xs font-black tracking-widest uppercase text-fg dark:text-fg-dark mb-1">Ecosystem</strong>
        <a href="https://github.com/krewire/framework" target="_blank" rel="noopener" class="footer-link">krewire/framework</a>
        <a href="https://github.com/krewire/kiw" target="_blank" rel="noopener" class="footer-link">krewire/kiw</a>
        <a href="https://github.com/krewire/libs" target="_blank" rel="noopener" class="footer-link">krewire/libs</a>
        <a href="https://github.com/krewire/mdbind" target="_blank" rel="noopener" class="footer-link">krewire/mdbind</a>
        <a href="https://github.com/krewire/boost" target="_blank" rel="noopener" class="footer-link">krewire/boost</a>
        <a href="https://github.com/orgs/krewire/discussions" target="_blank" rel="noopener" class="footer-link">Community Forum</a>
      </div>
    </div>

    <!-- Footer bottom -->
    <div class="pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 text-xs font-semibold text-muted dark:text-muted-dark">
      <span>© 2026 Krewire Contributors — 100% built with Krewire <code class="code-inline">site</code> workload.</span>
      <a href="https://github.com/krewire" target="_blank" rel="noopener" class="hover:text-primary transition-colors">github.com/krewire</a>
    </div>
  </div>
</footer>
{{end}}

<style>
.footer-simple {
  border-top: 1px solid var(--border);
  margin-top: 32px;
  background: var(--bg-2);
}
.footer-simple-inner {
  max-width: 80rem;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 1.5rem 1rem;
  font-size: 0.75rem;
  color: var(--muted);
}
.footer-simple-inner a {
  color: var(--muted);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.footer-full {
  background: var(--bg-2);
  border-top: var(--pop-border);
}
.brand-icon {
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: var(--primary);
  color: var(--primary-content);
  font-size: 14px;
  font-weight: 900;
}
.footer-link {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.15s ease;
}
.footer-link:hover {
  color: var(--primary);
  text-decoration: none;
}
</style>
