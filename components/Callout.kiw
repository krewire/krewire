
<div class="callout {{.Type}}">
  <strong>{{.Title}}</strong>
  <p>{{.Body}}</p>
</div>

<style>
.callout{padding:14px 16px;border-radius:12px;border:1px solid var(--border);background:var(--bg-2);margin:16px 0}
.callout strong{font-size:13px}
.callout p{margin:6px 0 0;font-size:13px;color:color-mix(in srgb, var(--fg) 80%, var(--muted))}
.callout.info{border-color:color-mix(in srgb, #0ea5e9 30%, var(--border))}
.callout.warn{border-color:color-mix(in srgb, #f59e0b 30%, var(--border))}
</style>
