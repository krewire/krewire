<div class="feature-card">
  <div class="card-top">
    <div class="icon-box">{{.Icon}}</div>
    {{with .Badge}}<span class="card-badge">{{.}}</span>{{end}}
  </div>
  <h3>{{.Title}}</h3>
  <p>{{.Desc}}</p>
  {{with .Cmd}}
  <div class="cmd-pill"><code>{{.}}</code></div>
  {{end}}
</div>

<style>
.feature-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:14px;
  padding:20px 18px;
  box-shadow:var(--pop-shadow);
  display:flex;
  flex-direction:column;
  transition:transform .15s ease, box-shadow .15s ease;
  word-break:break-word;
}
.feature-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:12px;
}
.icon-box{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  font-size:18px;
  font-weight:900;
}
.card-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2px 8px;
  border-radius:6px;
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  background:var(--bg-2);
  color:var(--fg);
  text-transform:uppercase;
  letter-spacing:.05em;
  font-family:ui-monospace, monospace;
}
.feature-card h3{
  margin:0 0 6px;
  font-size:16.5px;
  font-weight:900;
  letter-spacing:-.01em;
}
.feature-card p{
  margin:0;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
  font-weight:500;
}
.cmd-pill{
  margin-top:14px;
  padding:5px 10px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  border-radius:6px;
  box-shadow:1.5px 1.5px 0px var(--border);
  width:fit-content;
}
.cmd-pill code{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  font-weight:800;
  color:var(--fg);
}
</style>
