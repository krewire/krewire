
<div class="card rounded-2xl border border-border p-5 bg-bg shadow-sm hover:-translate-y-0.5 transition">
  <div class="icon w-10 h-10 rounded-xl grid place-items-center bg-primary/10 text-lg">{{.Icon}}</div>
  <h3 class="text-sm font-semibold mt-3 mb-1.5">{{.Title}}</h3>
  <p class="text-xs text-muted leading-relaxed m-0">{{.Desc}}</p>
</div>

<style>
.card:hover{border-color:color-mix(in srgb, var(--primary) 25%, var(--border))}
</style>
