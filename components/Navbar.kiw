<header class="navbar">
  <div class="navbar-inner">
    <div class="navbar-left">
      {{if .ShowSidebarToggle}}
      <button class="sidebar-toggle" id="site-sidebar-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="site-sidebar">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
      </button>
      {{end}}
      {{component "Brand" .}}
    </div>

    <div class="navbar-center">
      {{component "NavMenu" .}}
    </div>

    <div class="navbar-right">
      <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="gh-link">
        <span>★</span><span>GitHub</span>
      </a>
      {{component "ThemeSwitch" .}}
      {{component "Toggler" (dict "ID" "nav-toggler" "Label" "Toggle menu" "Controls" "nav-mobile-menu")}}
    </div>
  </div>

  <!-- Mobile navigation drawer -->
  <div id="nav-mobile-menu" class="nav-mobile-dropdown opacity-0 pointer-events-none -translate-y-2">
    <div class="nav-mobile-content">
      <a href="/getting-started" class="mobile-item">
        <span class="bullet">›</span> Get Started
      </a>
      <a href="/docs/krewire-workloads" class="mobile-item">
        <span class="bullet">▦</span> 8 Workloads
      </a>
      <a href="/getting-started/dsl" class="mobile-item">
        <span class="bullet">◈</span> Component DSL
      </a>
      <a href="/docs" class="mobile-item">
        <span class="bullet">≡</span> Documentation
      </a>
      <a href="/#ecosystem" class="mobile-item">
        <span class="bullet">⬢</span> Ecosystem
      </a>
      <hr class="mobile-divider">
      <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="mobile-gh-btn">
        <span>★ GitHub Repository</span><span>↗</span>
      </a>
    </div>
  </div>
</header>

<style>
.navbar {
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
  background: color-mix(in srgb, var(--bg) 90%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: var(--pop-border);
}
.navbar-inner {
  max-width: 80rem;
  margin: 0 auto;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.navbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.navbar-center {
  display: flex;
  align-items: center;
  margin-left: auto;
}
.navbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  background: var(--bg-2);
  color: var(--fg);
  cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.sidebar-toggle:hover {
  border-color: var(--primary);
  color: var(--primary);
}
.gh-link {
  display: none;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 800;
  border-radius: 8px;
  background: var(--primary);
  color: var(--primary-content);
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  text-decoration: none;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.gh-link:hover {
  transform: translate(-1px, -1px);
  box-shadow: var(--pop-shadow);
  text-decoration: none;
}
@media (min-width: 768px) {
  .gh-link {
    display: inline-flex;
  }
  .navbar-right [id="nav-toggler"] {
    display: none !important;
  }
}
@media (min-width: 64rem) {
  .sidebar-toggle {
    display: none !important;
  }
}
.nav-mobile-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background: var(--bg);
  border-bottom: var(--pop-border);
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
@media (min-width: 768px) {
  .nav-mobile-dropdown {
    display: none !important;
  }
}
.nav-mobile-content {
  max-width: 80rem;
  margin: 0 auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.mobile-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 800;
  color: var(--fg);
  text-decoration: none;
  min-height: 44px;
  transition: background 0.15s ease, color 0.15s ease;
}
.mobile-item:hover {
  background: var(--bg-2);
  color: var(--primary);
  text-decoration: none;
}
.mobile-item .bullet {
  color: var(--primary);
  font-size: 16px;
  font-weight: 900;
  width: 16px;
}
.mobile-divider {
  margin: 6px 0;
  border: none;
  border-top: var(--pop-border-thin);
}
.mobile-gh-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 800;
  background: var(--primary);
  color: var(--primary-content);
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  text-decoration: none;
  min-height: 44px;
}
.mobile-gh-btn:hover {
  text-decoration: none;
  opacity: 0.95;
}
</style>
