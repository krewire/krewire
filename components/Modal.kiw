<dialog class="modal-dialog {{.Class}}" id="{{.Id}}">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">{{.Title}}</h3>
      <button type="button" class="modal-close" aria-label="Close dialog" onclick="this.closest('dialog').close()">✕</button>
    </div>
    <div class="modal-body">
      {{with .Body}}{{.}}{{end}}
    </div>
    {{with .Footer}}
    <div class="modal-footer">
      {{.}}
    </div>
    {{end}}
  </div>
</dialog>

<style>
.modal-dialog {
  border: none;
  background: transparent;
  padding: 1rem;
  max-width: min(90vw, 520px);
  width: 100%;
}
.modal-dialog::backdrop {
  background: rgba(11, 31, 59, 0.45);
  backdrop-filter: blur(3px);
}
.modal-box {
  background: var(--bg, #FAF8F4);
  border: var(--pop-border, 2.5px solid var(--border, #0B1F3B));
  border-radius: var(--radius, 14px);
  box-shadow: var(--pop-shadow-lg, 6px 6px 0px var(--border, #0B1F3B));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.25rem;
  background: var(--bg-2, #f0ede5);
  border-bottom: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
}
.modal-title {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--fg, #0B1F3B);
}
.modal-close {
  background: transparent;
  border: 1.5px solid var(--border, #0B1F3B);
  border-radius: 6px;
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  font-size: 0.85rem;
  font-weight: 800;
  cursor: pointer;
  color: var(--fg, #0B1F3B);
}
.modal-close:hover {
  background: var(--error, #FF3B2E);
  color: #fff;
  border-color: var(--error, #FF3B2E);
}
.modal-body {
  padding: 1.25rem;
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--fg, #0B1F3B);
}
.modal-footer {
  padding: 0.85rem 1.25rem;
  background: var(--bg-2, #f0ede5);
  border-top: 1.5px solid var(--border-subtle, rgba(11,31,59,.15));
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
}
</style>
