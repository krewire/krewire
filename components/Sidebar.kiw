<aside class="site-sidebar" id="site-sidebar" aria-label="Sidebar">
  <div class="sidebar-head">
    <span class="sidebar-title">{{if .Title}}{{.Title}}{{else}}Navigate{{end}}</span>
    <button class="sidebar-close" id="site-sidebar-close" aria-label="Close navigation">×</button>
  </div>
  <SideMenu . />
</aside>
<div class="sidebar-overlay" id="site-sidebar-overlay" aria-hidden="true"></div>

<style>
.site-sidebar {
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 0.92rem;
  background: var(--bg);
}
.sidebar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}
.sidebar-title {
  margin: 0;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
}
.sidebar-close {
  display: none;
  border: 1.5px solid var(--border);
  background: var(--bg-2);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  color: var(--muted);
  transition: all 0.15s ease;
}
.sidebar-close:hover {
  color: var(--fg);
  border-color: var(--primary);
}
.sidebar-overlay {
  display: none;
}

/* small & medium: <64rem (md and below) drawer */
@media (max-width: 63.99rem) {
  .site-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(82vw, 19rem);
    max-width: 19rem;
    padding: 1rem 1rem 2rem;
    overflow-y: auto;
    border-right: var(--pop-border);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
    transform: translateX(-100%);
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 60;
  }
  .sidebar-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 55;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  html.sidebar-open .site-sidebar {
    transform: translateX(0);
  }
  html.sidebar-open .sidebar-overlay {
    opacity: 1;
    pointer-events: auto;
    display: block;
  }
}
/* large: 64rem+ */
@media (min-width: 64rem) {
  .site-sidebar {
    align-self: start;
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }
  .sidebar-close, .sidebar-overlay {
    display: none !important;
  }
}
</style>
