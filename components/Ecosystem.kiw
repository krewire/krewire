          <span class="badge badge-primary text-2xs font-mono">Core Engine</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">framework</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3">App · web · UI · runtime · worker · service · infra workloads in unified Go.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/framework</code>
        </div>
      </a>

      <a href="https://github.com/krewire/kiw" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150"
         style="background:var(--bg); border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge badge-secondary text-2xs font-mono">Developer CLI</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
        <h3 class="text-lg font-black tracking-tight mb-2 text-fg dark:text-fg-dark">kiw</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed flex-1 mb-3">Developer multi-tool: instant scaffolding, fast builds, dev server, and deployment.</p>
        <div class="mt-auto px-2 py-1 rounded-md font-mono text-xs font-bold text-muted dark:text-muted-dark bg-bg-2 dark:bg-bg-dark-2 w-fit" style="border:1.5px solid var(--border)">
          <code>github.com/krewire/kiw</code>
        </div>
      </a>

      <a href="https://github.com/krewire/libs" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150"
         style="background:var(--bg); border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge text-2xs font-mono" style="background:#ffbd2e; color:#0B1F3B; border:var(--pop-border-thin); box-shadow:var(--pop-shadow-sm)">Foundation</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
        </div>
