<section id="ecosystem" class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-12 lg:py-16" style="border-top:var(--pop-border); border-bottom:var(--pop-border)">
  <div class="container-site">
    <div class="section-head">
      <span class="badge badge-primary mb-3">Official Ecosystem</span>
      <h2>Ecosystem — One <code style="font-family:ui-monospace,monospace; font-size:.85em; background:var(--bg); border:1.5px solid var(--border); padding:1px 8px; border-radius:6px">kiw</code> for Everything</h2>
      <p>Modular, high-performance Go libraries engineered to build every workload together or standalone.</p>
    </div>

    <!-- Grid: 1 col → sm: 2 col → lg: 5 col -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

      <a href="https://github.com/krewire/framework" target="_blank" rel="noopener"
