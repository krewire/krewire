      <a href="https://github.com/krewire/mdbind" target="_blank" rel="noopener"
         class="eco-card flex flex-col p-5 rounded-xl no-underline transition-all duration-150"
         style="background:var(--bg); border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="badge badge-muted text-2xs font-mono">Pipeline</span>
          <span class="eco-arrow text-base font-black text-muted dark:text-muted-dark transition-all duration-150">↗</span>
