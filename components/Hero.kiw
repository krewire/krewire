
<section class="hero grid md:grid-cols-[1.1fr_0.9fr] gap-10 items-center py-16">
  <div class="copy">
    <div class="eyebrow text-xs tracking-widest uppercase text-muted font-semibold">Unified Go Framework · v0.1.0</div>
    <h1 class="font-serif text-5xl md:text-6xl leading-none tracking-tight my-3">One Go Framework.<br class="hidden md:block"> Every Workload.</h1>
    <p class="text-lg text-muted max-w-xl">One framework for every web-service workload — <b>app, cli, site, book, worker, service, infra, runtime</b>. One CLI <code class="font-mono text-sm bg-bg-2 border border-border px-1.5 py-0.5 rounded-lg">kiw</code>, one config <code class="font-mono text-sm bg-bg-2 border border-border px-1.5 py-0.5 rounded-lg">krewire.yaml</code>.</p>
    <div class="ctas flex gap-3 mt-6 flex-wrap">
      <a class="btn primary inline-flex items-center gap-2 px-4 py-2.5 rounded-full border font-semibold text-sm bg-primary text-white border-primary" href="/docs/getting-started">Get Started</a>
      <a class="btn inline-flex items-center gap-2 px-4 py-2.5 rounded-full border font-semibold text-sm" href="https://github.com/krewire/krewire">View on GitHub</a>
    </div>
    <div class="meta mt-4 text-xs text-muted"><span>Go 1.22+ · File-based routing · Scoped CSS · No JS by default</span></div>
  </div>
  <div class="art min-w-0">{{component "CodeWindow" .}}</div>
</section>

<style>
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:72px 0 24px}
.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600}
.hero h1{font-family:ui-serif, Georgia, serif;font-size:56px;line-height:.95;letter-spacing:-.04em;margin:12px 0 16px}
.hero p{font-size:18px;color:color-mix(in srgb, var(--fg) 70%, var(--muted));max-width:560px}
.hero code{font-family:ui-monospace, SFMono-Regular, Menlo, monospace;font-size:13px;background:var(--bg-2);border:1px solid var(--border);padding:2px 6px;border-radius:8px}
.ctas{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:999px;border:1px solid var(--border);background:var(--bg);font-weight:600;font-size:14px}
.btn.primary{background:var(--primary);color:var(--primary-content, #fff);border-color:var(--primary)}
.meta{margin-top:18px;font-size:12px;color:var(--muted)}
.art{min-width:0}
@media(max-width:900px){.hero{grid-template-columns:1fr;padding:36px 0}.hero h1{font-size:42px}}
</style>
