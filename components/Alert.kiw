<div class="alert alert-{{if .Variant}}{{.Variant}}{{else}}info{{end}} {{.Class}}" role="alert">
  <div class="alert-icon">
    {{with .Icon}}
      {{.}}
    {{else}}
      {{if eq .Variant "success"}}✓
      {{else if eq .Variant "warning"}}⚠
      {{else if eq .Variant "danger"}}✕
      {{else}}ℹ{{end}}
    {{end}}
  </div>
  <div class="alert-content">
    {{with .Title}}<strong class="alert-title">{{.}}</strong>{{end}}
    <div class="alert-message">{{with .Message}}{{.}}{{else}}{{with .Body}}{{.}}{{end}}{{end}}</div>
  </div>
  {{if .Dismissible}}
  <button type="button" class="alert-close" aria-label="Dismiss alert" onclick="this.closest('.alert').remove()">×</button>
  {{end}}
</div>

<style>
.alert {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  padding: 0.9rem 1.15rem;
  border-radius: var(--radius, 10px);
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  box-shadow: var(--pop-shadow-sm, 2px 2px 0px var(--border, #0B1F3B));
  margin: 1rem 0;
  font-size: 0.9rem;
  line-height: 1.5;
  box-sizing: border-box;
}
.alert-icon {
  font-size: 1.1rem;
  font-weight: 900;
  line-height: 1.2;
  flex-shrink: 0;
}
.alert-content {
  flex: 1;
  min-width: 0;
}
.alert-title {
  display: block;
  font-size: 0.92rem;
  font-weight: 800;
  margin-bottom: 0.2rem;
}
.alert-message {
  font-size: 0.88rem;
}
.alert-close {
  background: transparent;
  border: 1px solid var(--border, #0B1F3B);
  border-radius: 6px;
  cursor: pointer;
  font-size: 1.1rem;
  line-height: 1;
  padding: 0.15rem 0.4rem;
  color: var(--fg, #0B1F3B);
}
.alert-close:hover {
  background: var(--bg-2, #f0ede5);
}

.alert-info {
  background: color-mix(in srgb, var(--secondary, #00D1C1) 18%, var(--bg, #FAF8F4));
  border-color: var(--border, #0B1F3B);
}
.alert-success {
  background: color-mix(in srgb, var(--success, #39D353) 22%, var(--bg, #FAF8F4));
  border-color: var(--border, #0B1F3B);
}
.alert-warning {
  background: color-mix(in srgb, var(--warning, #ffb703) 25%, var(--bg, #FAF8F4));
  border-color: var(--border, #0B1F3B);
}
.alert-danger {
  background: color-mix(in srgb, var(--error, #FF3B2E) 18%, var(--bg, #FAF8F4));
  border-color: var(--border, #0B1F3B);
}
</style>
